<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthOps - Book Appointment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --light-color: #ecf0f1;
            --success-color: #27ae60;
            --warning-color: #f39c12;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .appointment-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            margin: 2rem auto;
            max-width: 1200px;
        }

        .header {
            background: var(--primary-color);
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .calendar-container {
            padding: 2rem;
            background: var(--light-color);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            margin-top: 1rem;
        }

        .calendar-day {
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
        }

            .calendar-day:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .day-header {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .day-number {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .day-status {
            font-size: 0.8rem;
            padding: 3px 8px;
            border-radius: 15px;
            display: inline-block;
        }

        .status-free {
            background: var(--success-color);
            color: white;
        }

        .status-almost-full {
            background: var(--warning-color);
            color: white;
        }

        .status-booked {
            background: var(--accent-color);
            color: white;
        }

        .status-weekend {
            background: #95a5a6;
            color: white;
        }

        .time-slots {
            max-height: 400px;
            overflow-y: auto;
        }

        .time-slot {
            padding: 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .time-slot:hover {
                border-color: var(--secondary-color);
            }

            .time-slot.selected {
                border-color: var(--secondary-color);
                background: rgba(52, 152, 219, 0.1);
            }

            .time-slot.unavailable {
                background: #f8f9fa;
                color: #6c757d;
                cursor: not-allowed;
            }

        .form-section {
            padding: 2rem;
        }

        .form-control:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

        .btn-primary {
            background: var(--secondary-color);
            border: none;
            padding: 12px 30px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: #2980b9;
                transform: translateY(-2px);
            }

        .nav-tabs .nav-link.active {
            color: var(--secondary-color);
            font-weight: bold;
            border-bottom: 3px solid var(--secondary-color);
        }

        .progress-bar {
            background: var(--secondary-color);
        }

        .confirmation {
            text-align: center;
            padding: 3rem;
        }

            .confirmation i {
                font-size: 4rem;
                color: var(--success-color);
                margin-bottom: 1rem;
            }


        .calendar-grid {
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }

        .calendar-day {
            padding: 8px;
        }

        .day-number {
            font-size: 1.2rem;
        }

        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="appointment-container">
            <div class="header">
                <h1><i class="fas fa-calendar-check me-3"></i>Book Your Appointment</h1>
                <p class="lead">Schedule your visit with our healthcare professionals</p>
            </div>

            <!-- Progress Bar -->
            <div class="px-4 pt-4">
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar" role="progressbar" style="width: 33%;" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <span class="text-primary fw-bold">1. Choose Date</span>
                    <span>2. Select Time</span>
                    <span>3. Your Details</span>
                    <span>4. Confirm</span>
                </div>
            </div>

            <div class="row g-0">
                <!-- Left Side - Calendar -->
                <div class="col-lg-6">
                    <div class="calendar-container">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3>Select a Date</h3>
                            <div class="btn-group">
                                <button class="btn btn-outline-primary" id="prev-month">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="btn btn-outline-primary" id="next-month">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <h4 id="current-month" class="text-center mb-4">September 2024</h4>

                        <div class="calendar-grid" id="calendar-grid">
                            <!-- Calendar will be generated here -->
                        </div>
                    </div>
                </div>

                <!-- Right Side - Time Slots and Form -->
                <div class="col-lg-6">
                    <div class="form-section">
                        <!-- Time Slots Section -->
                        <div id="time-slots-section">
                            <h4 class="mb-4">Available Time Slots</h4>
                            <p class="text-muted" id="selected-date">Select a date to see available times</p>
                            <div class="time-slots" id="time-slots-container">
                                <!-- Time slots will be loaded here -->
                            </div>
                        </div>

                        <!-- Patient Form Section -->
                        <div id="patient-form-section" style="display: none;">
                            <h4 class="mb-4">Your Information</h4>
                            <form id="appointment-form">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Full Name *</label>
                                        <input type="text" class="form-control" id="patient-name" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">ID Number</label>
                                        <input type="text" class="form-control" id="patient-id">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Email *</label>
                                        <input type="email" class="form-control" id="patient-email" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Phone *</label>
                                        <input type="tel" class="form-control" id="patient-phone" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Doctor *</label>
                                    <select class="form-select" id="doctor-id" required>
                                        <option value="">Loading doctors...</option>
                                    </select>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Notes (Reason for visit)</label>
                                    <textarea class="form-control" id="notes" rows="3" placeholder="Please describe the reason for your appointment"></textarea>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="button" class="btn btn-outline-secondary" id="back-to-slots">
                                        Back to Time Slots
                                    </button>
                                    <button type="submit" class="btn btn-primary">
                                        Confirm Appointment
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Confirmation Section -->
                        <div id="confirmation-section" class="confirmation" style="display: none;">
                            <i class="fas fa-check-circle"></i>
                            <h3>Appointment Confirmed!</h3>
                            <p id="confirmation-details"></p>
                            <button class="btn btn-primary" id="new-booking">
                                Book Another Appointment
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
     
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Function to load doctors from database
        function loadDoctors() {
            fetch('/Appointment/GetDoctors')
                .then(response => response.json())
                .then(doctors => {
                    const doctorSelect = document.getElementById('doctor-id');
                    doctorSelect.innerHTML = '<option value="">Select a doctor...</option>';

                    doctors.forEach(doctor => {
                        const option = document.createElement('option');
                        option.value = doctor.id;
                        option.textContent = doctor.name;
                        doctorSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error loading doctors:', error);
                    const doctorSelect = document.getElementById('doctor-id');
                    doctorSelect.innerHTML = '<option value="">Error loading doctors. Please refresh.</option>';
                });
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Load doctors when page loads
            loadDoctors();

            // Current date tracking
            let currentDate = new Date();
            let selectedDate = null;
            let selectedTime = null;

            // DOM Elements
            const calendarGrid = document.getElementById('calendar-grid');
            const currentMonthEl = document.getElementById('current-month');
            const prevMonthBtn = document.getElementById('prev-month');
            const nextMonthBtn = document.getElementById('next-month');
            const timeSlotsContainer = document.getElementById('time-slots-container');
            const selectedDateEl = document.getElementById('selected-date');
            const timeSlotsSection = document.getElementById('time-slots-section');
            const patientFormSection = document.getElementById('patient-form-section');
            const confirmationSection = document.getElementById('confirmation-section');
            const appointmentForm = document.getElementById('appointment-form');
            const backToSlotsBtn = document.getElementById('back-to-slots');
            const newBookingBtn = document.getElementById('new-booking');

            // Initialize calendar
            renderCalendar(currentDate);
            updateMonthNavigation();

            // Event Listeners
            prevMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar(currentDate);
                updateMonthNavigation();
            });

            nextMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar(currentDate);
                updateMonthNavigation();
            });

            backToSlotsBtn.addEventListener('click', () => {
                patientFormSection.style.display = 'none';
                timeSlotsSection.style.display = 'block';
            });

            newBookingBtn.addEventListener('click', () => {
                location.reload();
            });

            appointmentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                bookAppointment();
            });

            // Functions
            function renderCalendar(date) {
                const year = date.getFullYear();
                const month = date.getMonth();

                currentMonthEl.textContent = date.toLocaleString('default', { month: 'long', year: 'numeric' });

                // Get month availability from server
                fetch(`/Appointment/GetMonthAvailability?year=${year}&month=${month + 1}`)
                    .then(response => response.json())
                    .then(data => {
                        renderCalendarGrid(data, year, month);
                    })
                    .catch(error => {
                        console.error('Error loading calendar:', error);
                    });
            }

            function renderCalendarGrid(availabilityData, year, month) {
                calendarGrid.innerHTML = '';

                // Add day headers
                const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
                days.forEach(day => {
                    const dayHeader = document.createElement('div');
                    dayHeader.className = 'calendar-day text-center fw-bold';
                    dayHeader.textContent = day;
                    calendarGrid.appendChild(dayHeader);
                });

                // Get first day of month and total days
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                // Add empty cells for days before first day of month
                for (let i = 0; i < firstDay; i++) {
                    calendarGrid.appendChild(createEmptyDay());
                }

                // Add days of month
                for (let day = 1; day <= daysInMonth; day++) {
                    const dateStr = `${year}-${month + 1}-${day}`;
                    const dayData = availabilityData.find(d => d.date === dateStr);

                    calendarGrid.appendChild(createDayElement(day, dayData));
                }
            }

            function createDayElement(day, dayData) {
                const dayEl = document.createElement('div');
                dayEl.className = 'calendar-day';

                if (dayData && dayData.status === 'weekend') {
                    dayEl.innerHTML = `
                        <div class="day-number">${day}</div>
                        <span class="day-status status-weekend">Weekend</span>
                    `;
                    dayEl.style.opacity = '0.6';
                } else if (dayData) {
                    dayEl.innerHTML = `
                        <div class="day-number">${day}</div>
                        <span class="day-status status-${dayData.status}">${dayData.availableSlots} slots</span>
                    `;

                    if (dayData.availableSlots > 0) {
                        dayEl.addEventListener('click', () => {
                            selectDate(new Date(dayData.date));
                        });
                    } else {
                        dayEl.style.opacity = '0.6';
                    }
                }

                return dayEl;
            }

            function createEmptyDay() {
                const emptyDay = document.createElement('div');
                emptyDay.className = 'calendar-day';
                emptyDay.style.visibility = 'hidden';
                return emptyDay;
            }

            function selectDate(date) {
                selectedDate = date;
                selectedDateEl.textContent = `Available times for ${date.toLocaleDateString()}`;

                // Load time slots for selected date
                fetch(`/Appointment/GetSlotAvailability?date=${date.toISOString()}`)
                    .then(response => response.json())
                    .then(slots => {
                        renderTimeSlots(slots);
                    })
                    .catch(error => {
                        console.error('Error loading time slots:', error);
                    });
            }

            function renderTimeSlots(slots) {
                timeSlotsContainer.innerHTML = '';

                slots.forEach(slot => {
                    const slotEl = document.createElement('div');
                    slotEl.className = `time-slot ${slot.available ? '' : 'unavailable'}`;

                    slotEl.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">${slot.start} - ${slot.end}</span>
                            <span>${slot.available ? 'Available' : 'Booked'}</span>
                        </div>
                    `;

                    if (slot.available) {
                        slotEl.addEventListener('click', () => {
                            selectTimeSlot(slotEl, slot);
                        });
                    }

                    timeSlotsContainer.appendChild(slotEl);
                });
            }

            function selectTimeSlot(slotEl, slot) {
                // Remove selected class from all slots
                document.querySelectorAll('.time-slot').forEach(el => {
                    el.classList.remove('selected');
                });

                // Add selected class to clicked slot
                slotEl.classList.add('selected');

                selectedTime = slot;

                // Show patient form after a brief delay
                setTimeout(() => {
                    timeSlotsSection.style.display = 'none';
                    patientFormSection.style.display = 'block';
                }, 500);
            }

            function bookAppointment() {
                const appointmentData = {
                    AppointmentDate: selectedDate.toISOString(),
                    AppointmentTime: selectedTime.start,
                    PatientName: document.getElementById('patient-name').value,
                    PatientIdNumber: document.getElementById('patient-id').value,
                    PatientEmail: document.getElementById('patient-email').value,
                    PatientPhone: document.getElementById('patient-phone').value,
                    DoctorId: parseInt(document.getElementById('doctor-id').value),
                    Notes: document.getElementById('notes').value
                };

                fetch('/Appointment/BookAppointment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(appointmentData)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showConfirmation(appointmentData);
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error booking appointment:', error);
                    alert('An error occurred while booking your appointment.');
                });
            }

            function showConfirmation(appointmentData) {
                patientFormSection.style.display = 'none';
                confirmationSection.style.display = 'block';

                // Get selected doctor name
                const doctorSelect = document.getElementById('doctor-id');
                const selectedDoctor = doctorSelect.options[doctorSelect.selectedIndex].text;

                const confirmationDetails = `
                    <strong>Date:</strong> ${new Date(appointmentData.AppointmentDate).toLocaleDateString()}<br>
                    <strong>Time:</strong> ${appointmentData.AppointmentTime}<br>
                    <strong>Doctor:</strong> ${selectedDoctor}<br>
                    <strong>Patient:</strong> ${appointmentData.PatientName}<br>
                    <strong>Reference:</strong> #${Math.random().toString(36).substr(2, 9).toUpperCase()}
                `;

                document.getElementById('confirmation-details').innerHTML = confirmationDetails;
            }

            function updateMonthNavigation() {
                const now = new Date();
                const nextMonth = new Date(currentDate);
                nextMonth.setMonth(nextMonth.getMonth() + 1);

                prevMonthBtn.disabled = currentDate.getMonth() === now.getMonth() &&
                                      currentDate.getFullYear() === now.getFullYear();
            }
        });
    </script>
</body>
</html>