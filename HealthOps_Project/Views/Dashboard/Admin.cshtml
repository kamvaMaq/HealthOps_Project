@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Welcome, Admin!</h2>
<p>Use the sidebar to manage staff, patients, appointments, reports, and consumables.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <a class="btn btn-primary w-100 mb-3" href="@Url.Action("Index", "Staff")">Manage Staff</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-success w-100 mb-3" href="@Url.Action("Index", "Patients")">Manage Patients</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-info w-100 mb-3" href="@Url.Action("Index", "Appointments")">Appointments</a>
    </div>
</div>
