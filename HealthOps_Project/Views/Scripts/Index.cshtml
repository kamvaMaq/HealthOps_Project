@model IEnumerable<HealthOps_Project.Models.Script>
@{ ViewData["Title"] = "Scripts"; }
<h2>Scripts</h2>
<p><a class="btn btn-primary" href="/Scripts/Create">Create new</a></p>
<table class="table"><thead><tr><th>Id</th><th>Name</th><th>Price</th><th></th></tr></thead><tbody>
@foreach(var s in Model){ <tr><td>@s.Id</td><td>@s.Name</td><td>@s.Price</td><td>
<a class="btn btn-sm btn-warning" href="/Scripts/Edit/@s.Id">Edit</a>
<a class="btn btn-sm btn-danger" href="/Scripts/Delete/@s.Id">Delete</a>
</td></tr> }
</tbody></table>
