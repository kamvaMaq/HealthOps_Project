<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HealthOps</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <style>
                .logo {
                    width: 40px; /* makes the image small */
                    height: auto; /* keeps aspect ratio */
                    position: absolute; /* allows positioning */
                    top: 0; /* top of the page */
                    left: 0; /* left corner */
                    margin: 10px; /* optional spacing from edges */
                }
            </style>
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/images/icon.jpeg" alt="HealthOps" class="logo" />
                HealthOps
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about-section">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact-section">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Register</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-3 mt-5 text-center">
        &copy; @DateTime.Now.Year HealthOps. All Rights Reserved.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
