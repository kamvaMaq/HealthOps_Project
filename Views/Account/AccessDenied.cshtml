@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg border-danger">
                <div class="card-body p-5">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                    <h1 class="text-danger mt-4 fw-bold">Access Denied</h1>
                    <p class="lead mt-3">You don't have permission to access this page.</p>

                    @if (ViewBag.ReturnUrl != null)
                    {
                        <div class="alert alert-warning mt-4">
                            <strong>Requested page:</strong> <code>@ViewBag.ReturnUrl</code>
                        </div>
                        <p class="text-muted">This page requires the <strong>Nurse</strong> role.</p>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-home me-2"></i>Go to Home
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary me-2">
                            <i class="fas fa-user me-2"></i>View Profile
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>