@model HealthOps_Project.Models.Bed
@{
    ViewData["Title"] = "Add New Bed";
}

<style>
    .beds-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
        animation: gradientShift 8s ease infinite;
        background-size: 200% 200%;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        animation: slideInUp 0.8s ease-out;
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
    }

    .header-gradient {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: headerGlow 3s ease-in-out infinite alternate;
    }

    @@keyframes headerGlow {
        from { background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%); }
        to { background: linear-gradient(135deg, #34495e 0%, #2980b9 100%); }
    }

    .form-control-custom {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 12px 20px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        animation: fadeInUp 0.6s ease-out;
    }

        .form-control-custom:focus {
            border-color: #3498db;
            box-shadow: 0 10px 25px rgba(52, 152, 219, 0.2);
            transform: translateY(-2px) scale(1.02);
            background: rgba(255, 255, 255, 0.95);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);
        animation: pulse 2s infinite;
    }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(52, 152, 219, 0.4);
            color: white;
            animation: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        animation: fadeInLeft 0.6s ease-out;
    }

    /* Enhanced Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes bounceIn {
        0% {
            opacity: 0;
            transform: scale(0.3);
        }
        50% {
            opacity: 1;
            transform: scale(1.05);
        }
        70% {
            transform: scale(0.9);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .form-group-animated {
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
        transition: all 0.3s ease;
    }

        .form-group-animated:hover {
            transform: translateY(-2px);
        }

    .form-group-animated:nth-child(1) { animation-delay: 0.1s; }
    .form-group-animated:nth-child(2) { animation-delay: 0.2s; }
    .form-group-animated:nth-child(3) { animation-delay: 0.3s; }
    .form-group-animated:nth-child(4) { animation-delay: 0.4s; }
    .form-group-animated:nth-child(5) { animation-delay: 0.5s; }

    .select-arrow {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 12px center;
        background-repeat: no-repeat;
        background-size: 16px 12px;
    }

    .input-hover-effect {
        transition: all 0.3s ease;
    }

        .input-hover-effect:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

    .floating-labels .form-label {
        position: relative;
        padding-left: 10px;
    }

        .floating-labels .form-label::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 4px;
            height: 20px;
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border-radius: 2px;
            animation: slideInLeft 0.6s ease-out;
        }

    .info-section {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border: 2px solid #90caf9;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
        animation: slideInDown 0.6s ease-out;
        transition: all 0.3s ease;
    }

        .info-section:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(144, 202, 249, 0.2);
        }

    @@keyframes slideInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        font-size: 1.8rem;
        margin: 0 auto 15px;
        animation: rotateIn 0.8s ease-out, float 3s ease-in-out infinite;
    }

    @@keyframes rotateIn {
        from {
            opacity: 0;
            transform: rotate(-180deg) scale(0.3);
        }
        to {
            opacity: 1;
            transform: rotate(0) scale(1);
        }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .form-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        animation: fadeInUp 0.6s ease-out;
        transition: all 0.3s ease;
    }

        .form-section:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

    .section-title {
        color: #2c3e50;
        border-bottom: 2px solid #3498db;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: 600;
        animation: slideInLeft 0.6s ease-out;
    }

    .required-field::after {
        content: " *";
        color: #e74c3c;
        font-weight: bold;
    }

    .form-note {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 5px;
        font-style: italic;
        animation: fadeInUp 0.6s ease-out;
    }

    .pulse-glow {
        animation: pulseGlow 2s ease-in-out infinite;
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 5px rgba(52, 152, 219, 0.5);
        }
        50% {
            box-shadow: 0 0 20px rgba(52, 152, 219, 0.8);
        }
    }

    .availability-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.8rem;
        animation: flipInX 0.6s ease-out;
    }

    .badge-available {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
    }

    .badge-occupied {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    @@keyframes flipInX {
        from {
            transform: perspective(400px) rotateX(90deg);
            opacity: 0;
        }
        to {
            transform: perspective(400px) rotateX(0deg);
            opacity: 1;
        }
    }

    .bed-preview {
        background: linear-gradient(135deg, #e8f4fd 0%, #d1e7f7 100%);
        border: 2px solid #3498db;
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        animation: fadeInUp 0.6s ease-out;
        transition: all 0.3s ease;
    }

        .bed-preview:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(52, 152, 219, 0.2);
        }

    .bed-icon {
        font-size: 3rem;
        margin-bottom: 15px;
        animation: bounceIn 1s ease-out;
    }
</style>

<div class="beds-container">
    <div class="container">
        <div class="glass-card">
            <div class="header-gradient">
                <div class="icon-wrapper">
                    🛏️
                </div>
                <h1 class="display-5 fw-bold mb-3">Add New Bed</h1>
                <p class="lead mb-0">Register a new bed in the hospital system</p>
            </div>

            <div class="p-4">
                <!-- Information Section -->
                <div class="info-section">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="text-primary mb-2">📋 Bed Registration Guidelines</h5>
                            <p class="mb-1">• Assign a unique bed number for identification</p>
                            <p class="mb-1">• Set initial availability status</p>
                            <p class="mb-0">• Assign to specific ward and room location</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="bg-light rounded-3 p-3 pulse-glow">
                                <small class="text-muted">Fields marked with <span class="text-danger">*</span> are required</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bed Preview -->
                <div class="bed-preview mb-4">
                    <div class="bed-icon">🛏️</div>
                    <h5 class="text-primary">New Bed Preview</h5>
                    <p class="text-muted mb-2">This bed will be added to the system</p>
                    <div id="bedStatusPreview" class="availability-badge badge-available">
                        🟢 Available
                    </div>
                </div>

                <form asp-action="Create" method="post" class="floating-labels">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 bounce-in"></div>

                    <!-- Bed Information Section -->
                    <div class="form-section">
                        <h4 class="section-title">🛏️ Bed Information</h4>
                        <div class="row g-4">
                            <div class="col-md-6 form-group-animated">
                                <label asp-for="BedNumber" class="form-label fw-bold required-field">Bed Number</label>
                                <input asp-for="BedNumber" class="form-control form-control-custom input-hover-effect pulse-glow"
                                       placeholder="Enter unique bed number" />
                                <span asp-validation-for="BedNumber" class="text-danger small mt-1"></span>
                                <div class="form-note">Unique identifier for the bed</div>
                            </div>

                            <div class="col-md-6 form-group-animated">
                                <label asp-for="IsAvailable" class="form-label fw-bold required-field">Availability Status</label>
                                <select asp-for="IsAvailable" class="form-control form-control-custom select-arrow input-hover-effect"
                                        id="availabilitySelect">
                                    <option value="true">🟢 Available</option>
                                    <option value="false">🔴 Occupied</option>
                                </select>
                                <span asp-validation-for="IsAvailable" class="text-danger small mt-1"></span>
                                <div class="form-note">Set initial availability status</div>
                            </div>
                        </div>
                    </div>

                    <!-- Location Information Section -->
                    <div class="form-section">
                        <h4 class="section-title">🏢 Location Information</h4>
                        <div class="row g-4">
                            <div class="col-md-6 form-group-animated">
                                <label asp-for="WardId" class="form-label fw-bold required-field">Ward</label>
                                <select asp-for="WardId" class="form-control form-control-custom select-arrow input-hover-effect" asp-items="ViewBag.WardId">
                                    <option value="">-- Select Ward --</option>
                                </select>
                                <span asp-validation-for="WardId" class="text-danger small mt-1"></span>
                                <div class="form-note">Select the ward for this bed</div>
                            </div>

                            <div class="col-md-6 form-group-animated">
                                <label asp-for="RoomId" class="form-label fw-bold required-field">Room</label>
                                <select asp-for="RoomId" class="form-control form-control-custom select-arrow input-hover-effect" asp-items="ViewBag.RoomId">
                                    <option value="">-- Select Room --</option>
                                </select>
                                <span asp-validation-for="RoomId" class="text-danger small mt-1"></span>
                                <div class="form-note">Select the room for this bed</div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information Section -->
               @*      <div class="form-section">
                        <h4 class="section-title">📝 Additional Information</h4>
                        <div class="row g-4">
                            <div class="col-12 form-group-animated">
                                <label asp-for="Notes" class="form-label fw-bold">Bed Notes</label>
                                <textarea asp-for="Notes" class="form-control form-control-custom input-hover-effect" rows="3"
                                          placeholder="Enter any additional notes about this bed (special equipment, maintenance notes, etc.)..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small mt-1"></span>
                                <div class="form-note">Optional notes for bed management</div>
                            </div>
                        </div>
                    </div> *@

                    <!-- Action Buttons -->
                    <div class="text-center mt-4 pt-3 border-top">
                        <button type="submit" class="btn-primary-glow me-3">
                            💾 Save Bed
                        </button>
                        <a asp-action="Index" class="btn-secondary-glow">
                            ↩️ Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced form interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Add focus effects to form controls
            const formControls = document.querySelectorAll('.form-control-custom');
            formControls.forEach(control => {
                control.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'translateY(-2px)';
                    this.style.animation = 'pulseGlow 1s ease-in-out';
                });

                control.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'translateY(0)';
                    this.style.animation = '';
                });
            });

            // Real-time availability preview
            const availabilitySelect = document.getElementById('availabilitySelect');
            const bedStatusPreview = document.getElementById('bedStatusPreview');

            if (availabilitySelect && bedStatusPreview) {
                availabilitySelect.addEventListener('change', function() {
                    if (this.value === 'true') {
                        bedStatusPreview.textContent = '🟢 Available';
                        bedStatusPreview.className = 'availability-badge badge-available';
                    } else {
                        bedStatusPreview.textContent = '🔴 Occupied';
                        bedStatusPreview.className = 'availability-badge badge-occupied';
                    }
                    bedStatusPreview.style.animation = 'flipInX 0.6s ease-out';
                });
            }

            // Add loading animation to submit button
            const submitButton = document.querySelector('.btn-primary-glow');
            const form = document.querySelector('form');

            form.addEventListener('submit', function() {
                submitButton.innerHTML = '⏳ Creating Bed...';
                submitButton.disabled = true;
                submitButton.style.opacity = '0.8';
                submitButton.style.animation = 'pulse 0.5s ease-in-out infinite';
            });

            // Add hover effects to form groups
            const formGroups = document.querySelectorAll('.form-group-animated');
            formGroups.forEach(group => {
                group.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                });

                group.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });

            // Real-time validation feedback
            document.querySelectorAll('.form-control-custom').forEach(input => {
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.style.background = 'rgba(255, 255, 255, 0.95)';
                    } else {
                        this.style.background = 'rgba(255, 255, 255, 0.9)';
                    }
                });
            });

            // Add parallax effect to icon
            const icon = document.querySelector('.icon-wrapper');
            if (icon) {
                document.addEventListener('mousemove', function(e) {
                    const x = (e.clientX / window.innerWidth - 0.5) * 20;
                    const y = (e.clientY / window.innerHeight - 0.5) * 20;
                    icon.style.transform = `rotate(${x}deg) translate(${x}px, ${y}px)`;
                });
            }

            // Add bed number validation
            const bedNumberInput = document.querySelector('#BedNumber');
            if (bedNumberInput) {
                bedNumberInput.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.style.borderColor = '#27ae60';
                    } else {
                        this.style.borderColor = '';
                    }
                });
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}