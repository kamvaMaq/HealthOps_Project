@model HealthOps_Project.Models.Bed
@{
    ViewData["Title"] = "Delete Bed";
}

<style>
    .beds-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
        animation: gradientShift 8s ease infinite;
        background-size: 200% 200%;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        animation: slideInUp 0.8s ease-out;
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
    }

    .header-gradient {
        background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: headerGlow 3s ease-in-out infinite alternate;
    }

    @@keyframes headerGlow {
        from { background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%); }
        to { background: linear-gradient(135deg, #34495e 0%, #c0392b 100%); }
    }

    .btn-danger-glow {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(231, 76, 60, 0.3);
        animation: pulse 2s infinite;
    }

        .btn-danger-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(231, 76, 60, 0.4);
            color: white;
            animation: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }

    .warning-card {
        background: linear-gradient(135deg, #fef5e7 0%, #fdebd0 100%);
        border: 2px solid #f39c12;
        border-radius: 15px;
        padding: 25px;
        margin: 20px 0;
        animation: shake 0.8s ease-in-out;
        transition: all 0.3s ease;
    }

        .warning-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(243, 156, 18, 0.2);
        }

    /* Enhanced Animations */
    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        font-size: 1.8rem;
        margin: 0 auto 15px;
        animation: rotateIn 0.8s ease-out, float 3s ease-in-out infinite;
    }

    @@keyframes rotateIn {
        from {
            opacity: 0;
            transform: rotate(-180deg) scale(0.3);
        }
        to {
            opacity: 1;
            transform: rotate(0) scale(1);
        }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .bed-details {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        padding: 20px;
        margin: 20px 0;
        animation: fadeInUp 0.6s ease-out;
        transition: all 0.3s ease;
    }

        .bed-details:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

        .detail-row:nth-child(1) { animation-delay: 0.1s; }
        .detail-row:nth-child(2) { animation-delay: 0.2s; }
        .detail-row:nth-child(3) { animation-delay: 0.3s; }
        .detail-row:nth-child(4) { animation-delay: 0.4s; }

        .detail-row:hover {
            background: rgba(255, 255, 255, 0.5);
            transform: translateX(5px);
            border-radius: 10px;
        }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
    }

    .detail-value {
        color: #34495e;
        font-weight: 500;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-weight: 600;
        font-size: 0.8rem;
        animation: flipInX 0.6s ease-out;
    }

    .badge-available {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
    }

    .badge-occupied {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    @@keyframes flipInX {
        from {
            transform: perspective(400px) rotateX(90deg);
            opacity: 0;
        }
        to {
            transform: perspective(400px) rotateX(0deg);
            opacity: 1;
        }
    }

    .pulse-glow {
        animation: pulseGlow 2s ease-in-out infinite;
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 5px rgba(231, 76, 60, 0.5);
        }
        50% {
            box-shadow: 0 0 20px rgba(231, 76, 60, 0.8);
        }
    }

    .consequences-alert {
        background: linear-gradient(135deg, #fdedec 0%, #fadbd8 100%);
        border: 2px solid #e74c3c;
        border-radius: 15px;
        padding: 20px;
        margin: 20px 0;
        animation: fadeInUp 0.6s ease-out;
    }
</style>

<div class="beds-container">
    <div class="container">
        <div class="glass-card">
            <div class="header-gradient">
                <div class="icon-wrapper">
                    🗑️
                </div>
                <h1 class="display-5 fw-bold mb-3">Delete Bed</h1>
                <p class="lead mb-0">Remove bed from the hospital system</p>
            </div>

            <div class="p-4">
                <!-- Warning Card -->
                <div class="warning-card">
                    <div class="text-center">
                        <h3 class="text-warning mb-3">⚠️ Critical Action</h3>
                        <p class="mb-3">
                            <strong>You are about to delete bed <span class="text-danger">@Model.BedNumber</span></strong>
                        </p>
                        <p class="mb-0">
                            This action cannot be undone. Please confirm this is the bed you want to remove.
                        </p>
                    </div>
                </div>

                <!-- Bed Details -->
                <div class="bed-details">
                    <h4 class="text-center text-primary mb-4">📋 Bed Information</h4>
                    <div class="detail-row">
                        <span class="detail-label">Bed Number:</span>
                        <span class="detail-value">@Model.BedNumber</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status:</span>
                        <span class="detail-value">
                            <span class="status-badge @(Model.IsAvailable ? "badge-available" : "badge-occupied")">
                                @(Model.IsAvailable ? "🟢 Available" : "🔴 Occupied")
                            </span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Ward:</span>
                        <span class="detail-value">@Model.Ward?.Name</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Room:</span>
                        <span class="detail-value">@Model.Room?.RoomNumber</span>
                    </div>
                </div>

                <!-- Consequences Alert -->
                <div class="consequences-alert">
                    <h5 class="text-danger mb-3">🚨 Important Notice</h5>
                    <p class="mb-2">• This action will permanently remove the bed from the system</p>
                    <p class="mb-2">• Any current patient assignments will be affected</p>
                    <p class="mb-0">• This operation cannot be reversed</p>
                </div>

                <!-- Action Form -->
                <form asp-action="Delete" method="post" class="text-center mt-4">
                    <input type="hidden" asp-for="BedId" />
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn-danger-glow">
                            🗑️ Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn-secondary-glow">
                            ↩️ Back to Beds
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Add click animation to buttons
            const buttons = document.querySelectorAll('.btn-danger-glow, .btn-secondary-glow');
            buttons.forEach(button => {
                button.addEventListener('click', function(e) {
                    this.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 150);
                });
            });

            // Add loading animation to delete button
            const deleteButton = document.querySelector('.btn-danger-glow');
            const form = document.querySelector('form');

            form.addEventListener('submit', function() {
                deleteButton.innerHTML = '⏳ Deleting...';
                deleteButton.disabled = true;
                deleteButton.style.opacity = '0.8';
                deleteButton.style.animation = 'pulse 0.5s ease-in-out infinite';
            });

            // Add hover effects to detail rows
            const detailRows = document.querySelectorAll('.detail-row');
            detailRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateX(5px)';
                    this.style.background = 'rgba(255, 255, 255, 0.5)';
                });

                row.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateX(0)';
                    this.style.background = '';
                });
            });

            // Add parallax effect to icon
            const icon = document.querySelector('.icon-wrapper');
            if (icon) {
                document.addEventListener('mousemove', function(e) {
                    const x = (e.clientX / window.innerWidth - 0.5) * 20;
                    const y = (e.clientY / window.innerHeight - 0.5) * 20;
                    icon.style.transform = `rotate(${x}deg) translate(${x}px, ${y}px)`;
                });
            }

            // Add warning card shake on hover
            const warningCard = document.querySelector('.warning-card');
            if (warningCard) {
                warningCard.addEventListener('mouseenter', function() {
                    this.style.animation = 'shake 0.5s ease-in-out';
                });

                warningCard.addEventListener('mouseleave', function() {
                    this.style.animation = '';
                });
            }

            // Add confirmation for delete button
            const confirmDelete = document.querySelector('.btn-danger-glow');
            if (confirmDelete) {
                confirmDelete.addEventListener('click', function(e) {
                    if (!confirm('Are you absolutely sure you want to delete this bed? This action cannot be undone.')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}