@model HealthOps_Project.Models.ConsumableRequest

@{
    ViewData["Title"] = "Delete Request";
}

<link rel="stylesheet" href="~/css/professional-styles.css" />
<partial name="_BackButton" />

<div class="professional-management-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="professional-glass-card professional-animate-in">
                    <!-- Header -->
                    <div class="professional-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                        <div class="row align-items-center">
                            <div class="col">
                                <h1 class="display-6 fw-bold mb-2">
                                    <i class="fas fa-trash me-3"></i>Delete Request
                                </h1>
                                <p class="mb-0">Remove request from system</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4">
                        <div class="alert alert-warning professional-animate-in">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Warning:</strong> Are you sure you want to delete this request? This action cannot be undone.
                        </div>

                        <div class="professional-info-card mb-4">
                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Request ID:</div>
                                <div class="col-sm-8">#@Model.Id</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Consumable:</div>
                                <div class="col-sm-8">@Model.Consumable?.Name</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Ward Name:</div>
                                <div class="col-sm-8">@Model.WardName</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Quantity:</div>
                                <div class="col-sm-8">@Model.QuantityRequested</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Status:</div>
                                <div class="col-sm-8">@Model.Status</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Requested At:</div>
                                <div class="col-sm-8">@Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        </div>

                        <form asp-action="Delete" method="post" class="d-grid gap-2 d-md-flex justify-content-md-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <a asp-action="Index" class="btn btn-professional-secondary me-md-2">
                                <i class="fas fa-arrow-left me-2"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-professional-delete">
                                <i class="fas fa-trash me-2"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/professional-scripts.js"></script>
}