@model HealthOps_Project.Models.Consumable

@{
    ViewData["Title"] = "Delete Consumable";
}

<link rel="stylesheet" href="~/css/professional-styles.css" />
<partial name="_BackButton" />

<div class="professional-management-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="professional-glass-card professional-animate-in">
                    <!-- Header -->
                    <div class="professional-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                        <div class="row align-items-center">
                            <div class="col">
                                <h1 class="display-6 fw-bold mb-2">
                                    <i class="fas fa-trash me-3"></i>Delete Consumable
                                </h1>
                                <p class="mb-0">Remove consumable from inventory</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4">
                        <div class="alert alert-warning professional-animate-in">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Warning:</strong> Are you sure you want to delete this consumable? This action cannot be undone and may affect related stock records.
                        </div>

                        <div class="professional-info-card mb-4">
                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Consumable ID:</div>
                                <div class="col-sm-8">@Model.ConsumableId</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Name:</div>
                                <div class="col-sm-8">@Model.Name</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Description:</div>
                                <div class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No description</span>
                                    }
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Unit:</div>
                                <div class="col-sm-8">@Model.Unit</div>
                            </div>
                        </div>

                        <form asp-action="Delete" method="post" class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <input type="hidden" asp-for="ConsumableId" />
                            <a asp-action="Index" class="btn btn-professional-secondary me-md-2">
                                <i class="fas fa-arrow-left me-2"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-professional-delete">
                                <i class="fas fa-trash me-2"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/professional-scripts.js"></script>
}