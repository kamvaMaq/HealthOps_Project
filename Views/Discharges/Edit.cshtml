@model HealthOps_Project.Models.Discharge

@{
    ViewData["Title"] = "Edit Discharge";
}

<style>
    .discharge-edit-container {
        background: linear-gradient(135deg, #654ea3 0%, #da98b4 100%);
        min-height: 100vh;
        padding: 40px 0;
        position: relative;
        overflow: hidden;
    }

        .discharge-edit-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 30%, rgba(101, 78, 163, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(218, 152, 180, 0.2) 0%, transparent 50%), radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
            animation: floatBackground 18s ease-in-out infinite;
        }

    .professional-glass-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(25px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        overflow: hidden;
        position: relative;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

        .professional-glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 35px 60px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

    .professional-header {
        background: linear-gradient(135deg, #654ea3 0%, #da98b4 100%);
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .professional-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            animation: professionalShimmer 4s infinite;
        }

    .form-control-glow {
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 14px 20px;
        font-size: 1rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        position: relative;
    }

        .form-control-glow:focus {
            border-color: #654ea3;
            box-shadow: 0 12px 30px rgba(101, 78, 163, 0.25);
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 1);
        }

        .form-control-glow:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #654ea3 0%, #da98b4 100%);
        border: none;
        border-radius: 15px;
        padding: 16px 40px;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 10px 30px rgba(101, 78, 163, 0.4);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        position: relative;
        overflow: hidden;
    }

        .btn-primary-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s;
        }

        .btn-primary-glow:hover::before {
            left: 100%;
        }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.08);
            box-shadow: 0 20px 40px rgba(101, 78, 163, 0.6);
            color: white;
            text-decoration: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        border-radius: 15px;
        padding: 16px 40px;
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.4s ease;
        box-shadow: 0 8px 25px rgba(108, 117, 125, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 35px rgba(108, 117, 125, 0.4);
            color: white;
            text-decoration: none;
        }

    .form-label {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 12px;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-label:hover {
            color: #654ea3;
            transform: translateX(5px);
        }

    .form-section {
        margin-bottom: 30px;
        padding: 25px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 18px;
        border-left: 5px solid #654ea3;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }

        .form-section:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateX(8px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    .form-check {
        padding: 18px 20px;
        background: rgba(255, 255, 255, 0.8);
        border-radius: 15px;
        margin: 15px 0;
        transition: all 0.3s ease;
        border-left: 4px solid #da98b4;
    }

        .form-check:hover {
            background: rgba(255, 255, 255, 0.95);
            transform: translateX(5px);
        }

    .form-check-input {
        width: 22px;
        height: 22px;
        margin-right: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .form-check-input:checked {
            background-color: #654ea3;
            border-color: #654ea3;
            transform: scale(1.1);
        }

    .form-check-label {
        font-weight: 600;
        color: #2c3e50;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .form-check:hover .form-check-label {
        color: #654ea3;
    }

    .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        margin-right: 15px;
        transition: all 0.4s ease;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

        .icon-wrapper:hover {
            transform: rotate(15deg) scale(1.1);
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.5);
        }

    .floating {
        animation: floating 4s ease-in-out infinite;
    }

    .pulse-animation {
        animation: pulse 2.5s infinite;
    }

    /* Animations */
    @@keyframes floatBackground {
        0%, 100% {
            transform: translate(0px, 0px) scale(1);
        }

        33% {
            transform: translate(20px, -15px) scale(1.02);
        }

        66% {
            transform: translate(-15px, 10px) scale(0.98);
        }
    }

    @@keyframes professionalShimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    @@keyframes floating {
        0%, 100% {
            transform: translate(0px, 0px) rotate(0deg);
        }

        33% {
            transform: translate(25px, -20px) rotate(120deg);
        }

        66% {
            transform: translate(-18px, 15px) rotate(240deg);
        }
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(101, 78, 163, 0.7);
        }

        70% {
            box-shadow: 0 0 0 12px rgba(101, 78, 163, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(101, 78, 163, 0);
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .animate-slide-in {
        animation: slideIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

    .input-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #654ea3;
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }

    .form-group {
        position: relative;
    }

    .form-group-with-icon .form-control-glow {
        padding-left: 50px;
    }

    .form-group-with-icon:hover .input-icon {
        transform: translateY(-50%) scale(1.2);
        color: #da98b4;
    }

    .character-counter {
        font-size: 0.8rem;
        text-align: right;
        margin-top: 5px;
        color: #7f8c8d;
        transition: all 0.3s ease;
    }

        .character-counter.warning {
            color: #e74c3c;
            font-weight: bold;
        }

        .character-counter.success {
            color: #654ea3;
            font-weight: bold;
        }

    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        animation: statusPulse 2s infinite;
    }

    .status-active {
        background: #654ea3;
        box-shadow: 0 0 10px rgba(101, 78, 163, 0.5);
    }

    .status-inactive {
        background: #95a5a6;
        box-shadow: 0 0 10px rgba(149, 165, 166, 0.5);
    }

    @@keyframes statusPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }
    }

    .info-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.8) 100%);
        border-radius: 14px;
        padding: 18px;
        margin: 10px 0;
        border-left: 4px solid #654ea3;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

        .info-card:hover {
            transform: translateX(5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

    .select-glow {
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 14px 20px;
        font-size: 1rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        position: relative;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23654ea3' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 1rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
    }

        .select-glow:focus {
            border-color: #654ea3;
            box-shadow: 0 12px 30px rgba(101, 78, 163, 0.25);
            transform: translateY(-2px);
            background-color: rgba(255, 255, 255, 1);
        }

        .select-glow:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .date-input-glow {
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 14px 20px;
        font-size: 1rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

        .date-input-glow:focus {
            border-color: #654ea3;
            box-shadow: 0 12px 30px rgba(101, 78, 163, 0.25);
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 1);
        }

        .date-input-glow:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }
</style>

<div class="discharge-edit-container">
    <div class="container">
        <div class="professional-glass-card animate-slide-in">
            <!-- Professional Header -->
            <div class="professional-header">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="icon-wrapper floating">
                        <span style="font-size: 2.2rem;">✏️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Edit Discharge Record</h1>
                <p class="lead mb-0 fs-6 opacity-90">Update discharge information and patient status</p>
            </div>

            <div class="p-5">
                <form asp-action="Edit" method="post" id="dischargeEditForm">
                    <input type="hidden" asp-for="Id" />

                    <!-- Discharge Date Section -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.2s;">
                        <label asp-for="DischargeDate" class="form-label">
                            <span class="pulse-animation">📅</span>
                            Discharge Date
                        </label>
                        <div class="form-group">
                            <input asp-for="DischargeDate" class="form-control date-input-glow" type="date"
                                   id="dischargeDateInput" />
                        </div>
                        <span asp-validation-for="DischargeDate" class="text-danger small"></span>
                    </div>

                    <!-- Reason Section -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.3s;">
                        <label asp-for="Reason" class="form-label">
                            <span class="pulse-animation">📝</span>
                            Discharge Reason
                        </label>
                        <div class="form-group form-group-with-icon">
                            <span class="input-icon">📝</span>
                            <input asp-for="Reason" class="form-control form-control-glow"
                                   placeholder="Enter discharge reason..."
                                   id="reasonInput"
                                   maxlength="200" />
                        </div>
                        <div class="character-counter" id="reasonCounter">0/200 characters</div>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <!-- Patient Selection Section -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.4s;">
                        <label asp-for="PatientId" class="form-label">
                            <span class="pulse-animation">👤</span>
                            Patient
                        </label>
                        <div class="form-group">
                            <select asp-for="PatientId" asp-items="ViewBag.PatientList" class="form-control select-glow">
                                <option value="">-- Select Patient --</option>
                            </select>
                        </div>
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>

                    <!-- Ward Selection Section -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.5s;">
                        <label asp-for="WardId" class="form-label">
                            <span class="pulse-animation">🏥</span>
                            Ward
                        </label>
                        <div class="form-group">
                            <select asp-for="WardId" asp-items="ViewBag.WardList" class="form-control select-glow">
                                <option value="">-- Select Ward --</option>
                            </select>
                        </div>
                        <span asp-validation-for="WardId" class="text-danger small"></span>
                    </div>

                    <!-- Status Section -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.6s;">
                        <label class="form-label">
                            <span class="pulse-animation">📊</span>
                            Record Status
                        </label>
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheckbox" />
                            <label asp-for="IsActive" class="form-check-label">
                                <span class="status-indicator @(Model.IsActive ? "status-active" : "status-inactive")"></span>
                                Record is
                                <span id="statusText" class="fw-bold">@(Model.IsActive ? "Active" : "Inactive")</span>
                                <small class="text-muted d-block mt-1">
                                    @if (Model.IsActive)

                                    {
                                        <span class="text-success">✅ This discharge record is currently active in the system</span>
                                    }

                                    else

                                    {
                                        <span class="text-warning">⏸️ This discharge record is currently inactive</span>
                                    }
                                </small>
                            </label>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="form-section animate-slide-in" style="animation-delay: 0.7s;">
                        <label class="form-label">
                            <span class="pulse-animation">ℹ️</span>
                            Discharge Information
                        </label>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-card">
                                    <h6 class="fw-bold mb-2">📈 Record Details</h6>
                                    <small class="text-muted">
                                        <div>• Record ID: <strong>#@Model.Id.ToString("D3")</strong></div>
                                        <div>• Created: <strong>@DateTime.Now.AddDays(-7).ToString("MMM dd, yyyy")</strong></div>
                                        <div>• Last Updated: <strong>@DateTime.Now.ToString("MMM dd, yyyy")</strong></div>
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card">
                                    <h6 class="fw-bold mb-2">⚙️ System Info</h6>
                                    <small class="text-muted">
                                        <div>• Current Date: <strong>@DateTime.Now.ToString("MMM dd, yyyy")</strong></div>
                                        <div>• Status: <strong>Editing Mode</strong></div>
                                        <div>• User: <strong>Administrator</strong></div>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top animate-slide-in" style="animation-delay: 0.8s;">
                        <button type="submit" class="btn-primary-glow" id="submitButton">
                            <span>💾</span>
                            <span>Update Discharge</span>
                        </button>
                        <a asp-action="Index" class="btn-secondary-glow">
                            <span>⬅</span>
                            <span>Back to Discharges</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Character counter for reason field
            const reasonInput = document.getElementById('reasonInput');
            const reasonCounter = document.getElementById('reasonCounter');
            const isActiveCheckbox = document.getElementById('isActiveCheckbox');
            const statusText = document.getElementById('statusText');
            const submitButton = document.getElementById('submitButton');
            const dischargeDateInput = document.getElementById('dischargeDateInput');

            // Initialize character counter
            function updateCharacterCounter(input, counter, maxLength) {
                const length = input.value.length;
                counter.textContent = `${length}/${maxLength} characters`;

                if (length > maxLength * 0.8) {
                    counter.classList.add('warning');
                    counter.classList.remove('success');
                } else if (length > 0) {
                    counter.classList.add('success');
                    counter.classList.remove('warning');
                } else {
                    counter.classList.remove('warning', 'success');
                }
            }

            // Set initial counter value
            updateCharacterCounter(reasonInput, reasonCounter, 200);

            // Add event listener for character counter
            reasonInput.addEventListener('input', () => updateCharacterCounter(reasonInput, reasonCounter, 200));

            // Status toggle animation
            isActiveCheckbox.addEventListener('change', function () {
                if (this.checked) {
                    statusText.textContent = 'Active';
                    statusText.className = 'fw-bold text-success';
                } else {
                    statusText.textContent = 'Inactive';
                    statusText.className = 'fw-bold text-warning';
                }

                // Add pulse animation
                const statusIndicator = this.parentElement.querySelector('.status-indicator');
                statusIndicator.style.animation = 'none';
                setTimeout(() => {
                    statusIndicator.style.animation = 'statusPulse 2s infinite';
                }, 10);
            });

            // Form submission enhancement
            const form = document.getElementById('dischargeEditForm');
            form.addEventListener('submit', function (e) {
                const originalText = submitButton.innerHTML;
                submitButton.innerHTML = `
                            <span class="professional-loading"></span>
                            <span>Updating Discharge...</span>
                        `;
                submitButton.disabled = true;

                // Revert after 5 seconds if still on page
                setTimeout(() => {
                    if (submitButton.disabled) {
                        submitButton.innerHTML = originalText;
                        submitButton.disabled = false;
                    }
                }, 5000);
            });

            // Enhanced input interactions
            document.querySelectorAll('.form-control-glow, .select-glow, .date-input-glow').forEach(input => {
                input.addEventListener('focus', function () {
                    this.parentElement.classList.add('focused');
                });

                input.addEventListener('blur', function () {
                    this.parentElement.classList.remove('focused');
                });

                // Real-time validation feedback
                input.addEventListener('input', function () {
                    if (this.value && this.value.trim().length > 0) {
                        this.classList.add('has-value');
                        this.classList.remove('is-invalid');
                    } else {
                        this.classList.remove('has-value');
                    }
                });
            });

            // Date input enhancement
            if (dischargeDateInput) {
                dischargeDateInput.addEventListener('change', function () {
                    if (this.value) {
                        this.classList.add('has-value');
                    } else {
                        this.classList.remove('has-value');
                    }
                });
            }

            // Add CSS for loading animation
            const style = document.createElement('style');
            style.textContent = `
                        .professional-loading {
                            display: inline-block;
                            width: 16px;
                            height: 16px;
                            border: 2px solid rgba(255, 255, 255, 0.3);
                            border-radius: 50%;
                            border-top-color: white;
                            animation: professionalSpin 1s ease-in-out infinite;
                            margin-right: 8px;
                        }

                        @@keyframes professionalSpin {
                            to { transform: rotate(360deg); }
                        }
                    `;
            document.head.appendChild(style);

            // Auto-focus on first input for better UX
            setTimeout(() => {
                dischargeDateInput.focus();
            }, 500);
        });
    </script>
}