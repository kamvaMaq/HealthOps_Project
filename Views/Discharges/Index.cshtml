@model IEnumerable<HealthOps_Project.Models.Discharge>

@{
    ViewData["Title"] = "Discharges Management";
}

<style>
    .discharges-management-container {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 50%, #F27121 100%);
        min-height: 100vh;
        padding: 40px 0;
        position: relative;
        overflow: hidden;
    }

        .discharges-management-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 30%, rgba(138, 35, 135, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(233, 64, 87, 0.2) 0%, transparent 50%), radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
            animation: floatBackground 20s ease-in-out infinite;
        }

    .professional-glass-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(25px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        overflow: hidden;
        position: relative;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

        .professional-glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 35px 60px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

    .professional-header {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .professional-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            animation: professionalShimmer 4s infinite;
        }

    .professional-action-bar {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 16px;
        padding: 25px;
        margin: 25px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
    }

        .professional-action-bar:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        border: none;
        border-radius: 15px;
        padding: 14px 32px;
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 8px 20px rgba(138, 35, 135, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        position: relative;
        overflow: hidden;
    }

        .btn-primary-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s;
        }

        .btn-primary-glow:hover::before {
            left: 100%;
        }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(138, 35, 135, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 14px 32px;
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }

    .professional-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        background: transparent;
    }

        .professional-table th {
            background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
            color: white;
            padding: 20px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 0.85rem;
            border: none;
            position: relative;
            transition: all 0.3s ease;
        }

            .professional-table th:hover {
                background: linear-gradient(135deg, #7a1f77 0%, #d9384f 100%);
            }

            .professional-table th::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 10%;
                width: 80%;
                height: 2px;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            }

        .professional-table td {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            vertical-align: middle;
            position: relative;
            background: rgba(255, 255, 255, 0.9);
        }

    .professional-table-row {
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        cursor: pointer;
        position: relative;
    }

        .professional-table-row::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, #8A2387, #E94057);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .professional-table-row:nth-child(even) {
            background: rgba(248, 249, 250, 0.9);
        }

        .professional-table-row:hover {
            transform: translateX(8px) translateY(-2px);
            background: linear-gradient(135deg, #f9f0ff 0%, #ffeef0 100%);
            box-shadow: 0 10px 25px rgba(138, 35, 135, 0.15);
            border-left: 4px solid #8A2387;
        }

            .professional-table-row:hover::before {
                transform: scaleY(1);
            }

    .btn-action {
        padding: 9px 16px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        border: none;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-width: 75px;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .btn-details {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        box-shadow: 0 4px 12px rgba(138, 35, 135, 0.3);
    }

    .btn-edit {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        box-shadow: 0 4px 12px rgba(243, 156, 18, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
    }

    .btn-action::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        transition: all 0.3s ease;
        transform: translate(-50%, -50%);
    }

    .btn-action:hover::before {
        width: 100%;
        height: 100%;
        border-radius: 10px;
    }

    .btn-action:hover {
        transform: translateY(-2px) scale(1.08);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.25);
        text-decoration: none;
        color: white;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.8rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        position: relative;
        overflow: hidden;
        letter-spacing: 0.3px;
    }

    .badge-inactive {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
    }

    .status-badge::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.5s;
    }

    .status-badge:hover::before {
        left: 100%;
    }

    .status-badge:hover {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    }

    .success-alert {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        border: 2px solid #28a745;
        border-radius: 20px;
        padding: 20px;
        margin: 20px 30px;
        box-shadow: 0 10px 25px rgba(40, 167, 69, 0.2);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .success-alert::before {
            content: '✅';
            position: absolute;
            top: -15px;
            right: -15px;
            font-size: 4rem;
            opacity: 0.1;
            animation: successFloat 3s ease-in-out infinite;
        }

        .success-alert:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(40, 167, 69, 0.3);
        }

    .btn-undo {
        background: linear-gradient(135deg, #ff9a00 0%, #ff6a00 100%);
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        color: white;
        font-weight: 600;
        font-size: 0.8rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(255, 154, 0, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-undo:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 8px 20px rgba(255, 154, 0, 0.4);
            color: white;
            text-decoration: none;
        }

    .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        margin-right: 15px;
        transition: all 0.4s ease;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

        .icon-wrapper:hover {
            transform: rotate(12deg) scale(1.1);
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.5);
        }

    .floating {
        animation: floating 4s ease-in-out infinite;
    }

    .pulse-animation {
        animation: pulse 2.5s infinite;
    }

    /* Animations */
    @@keyframes floatBackground {
        0%, 100% {
            transform: translate(0px, 0px) scale(1);
        }

        33% {
            transform: translate(20px, -15px) scale(1.02);
        }

        66% {
            transform: translate(-15px, 10px) scale(0.98);
        }
    }

    @@keyframes professionalShimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    @@keyframes floating {
        0%, 100% {
            transform: translate(0px, 0px) rotate(0deg);
        }

        33% {
            transform: translate(25px, -20px) rotate(120deg);
        }

        66% {
            transform: translate(-18px, 15px) rotate(240deg);
        }
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(138, 35, 135, 0.7);
        }

        70% {
            box-shadow: 0 0 0 12px rgba(138, 35, 135, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(138, 35, 135, 0);
        }
    }

    @@keyframes successFloat {
        0%, 100% {
            transform: rotate(0deg) translateY(0px);
        }

        50% {
            transform: rotate(5deg) translateY(-8px);
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(25px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .animate-slide-in {
        animation: slideIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

    .professional-stagger > * {
        opacity: 0;
        animation: slideIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

        .professional-stagger > *:nth-child(1) {
            animation-delay: 0.1s;
        }

        .professional-stagger > *:nth-child(2) {
            animation-delay: 0.2s;
        }

        .professional-stagger > *:nth-child(3) {
            animation-delay: 0.3s;
        }

    .info-button {
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        transition: all 0.3s ease;
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
    }

        .info-button:hover {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            transform: translateY(-50%) scale(1.1);
        }

    .patient-avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 0.9rem;
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        margin-right: 10px;
        transition: all 0.3s ease;
    }

        .patient-avatar:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 6px 15px rgba(138, 35, 135, 0.4);
        }

    .stat-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.4);
        transition: all 0.4s ease;
        margin-bottom: 15px;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #8A2387, #E94057, #8A2387);
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }

        .stat-card:hover::before {
            transform: scaleX(1);
        }

        .stat-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

    .professional-modal {
        border-radius: 20px;
        border: none;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

        .professional-modal .modal-header {
            background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
            color: white;
            border-bottom: none;
            padding: 25px;
        }

        .professional-modal .modal-body {
            padding: 25px;
            background: rgba(255, 255, 255, 0.95);
        }

        .professional-modal .modal-footer {
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            padding: 20px 25px;
            background: rgba(255, 255, 255, 0.98);
        }
</style>

<div class="discharges-management-container">
    <div class="container">
        <!-- Main Professional Glass Card -->
        <div class="professional-glass-card mb-5 animate-slide-in">
            <!-- Professional Header -->
            <div class="professional-header" style="position: relative;">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="icon-wrapper floating">
                        <span style="font-size: 2rem;">🏥</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Discharges Management</h1>
                <p class="lead mb-0 fs-6 opacity-90">Track and manage patient discharge records and documentation</p>

                <!-- Info Button -->
                <button type="button" class="info-button"
                        data-bs-toggle="modal" data-bs-target="#infoModal"
                        title="Click for more information">
                    ℹ️
                </button>
            </div>

            <!-- Success Alert -->
            @{
                var undoId = TempData["UndoDischargeId"] as int?;
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-alert animate-slide-in" style="animation-delay: 0.2s;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="fs-5">✅ @TempData["SuccessMessage"]</strong>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (undoId.HasValue)

                            {
                                <a asp-action="UndoDelete"
                                   asp-route-id="@undoId.Value"
                                   class="btn-undo">
                                    <span>↩️</span>
                                    <span>Undo</span>
                                </a>
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            }

            <!-- Professional Action Bar -->
            <div class="professional-action-bar d-flex justify-content-between align-items-center">
                <div class="d-flex gap-3">
                    <a asp-action="Create" class="btn-primary-glow">
                        <span>➕</span>
                        <span>Add New Discharge</span>
                    </a>
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-secondary-glow">
                        <span>📊</span>
                        <span>Dashboard</span>
                    </a>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-4 px-4 pb-4 professional-stagger">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-primary fw-bold" style="font-size: 2.2rem;">@Model.Count()</div>
                        <div class="text-muted fw-semibold">Total Discharges</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-warning fw-bold" style="font-size: 2.2rem;">
                            @Model.Count(d => d.DischargeDate.Date == DateTime.Today)
                        </div>
                        <div class="text-muted fw-semibold">Today's Discharges</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-info fw-bold" style="font-size: 2.2rem;">
                            @Model.Select(d => d.PatientId).Distinct().Count()
                        </div>
                        <div class="text-muted fw-semibold">Unique Patients</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-success fw-bold" style="font-size: 2.2rem;">
                            @Model.Select(d => d.WardId).Distinct().Count()
                        </div>
                        <div class="text-muted fw-semibold">Wards Involved</div>
                    </div>
                </div>
            </div>

            <!-- Discharges Table -->
            <div class="px-4 pb-4">
                <div class="table-responsive">
                    <table class="table professional-table">
                        <thead>
                            <tr>
                                <th style="width: 15%" class="text-start"></th>
                                <th style="width: 15%" class="text-start">Discharge Date</th>
                                <th style="width: 20%" class="text-start">Reason</th>
                                <th style="width: 20%" class="text-start">Patient Information</th>
                                <th style="width: 15%" class="text-start">Ward</th>
                                <th style="width: 15%" class="text-start">Status</th>
                                <th style="width: 15%" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dischargesTableBody">
                            @if (Model.Any())

                            {

                                var animationDelay = 0.3;
                                @foreach (var discharge in Model)

                                {
                                    <tr class="professional-table-row" style="animation-delay: @(animationDelay)s;">
                                        <td class="text-start fw-bold">
                                            <div class="text-dark fs-6">@discharge.DischargeDate.ToString("yyyy-MM-dd")</div>
                                            <small class="text-muted">@discharge.DischargeDate.ToString("hh:mm tt")</small>
                                        </td>
                                        <td class="text-start">
                                            <span class="fw-semibold">@discharge.Reason</span>
                                        </td>
                                        <td class="text-start">
                                            <div class="d-flex align-items-center">
                                                <div class="patient-avatar">
                                                    @discharge.Patient?.FirstName?[0]@discharge.Patient?.LastName?[0]
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@discharge.Patient?.FirstName @discharge.Patient?.LastName</div>
                                                @*     <small class="text-muted">ID: @discharge.PatientId</small> *@
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-start">
                                            <span class="fw-semibold text-dark">@discharge.Ward?.Name</span>
                                        </td>
                                        <td class="text-start">
                                            @if (discharge.IsActive)

                                            {
                                                <span class="status-badge badge-active">
                                                    🟢 Active
                                                </span>
                                            }

                                            else

                                            {
                                                <span class="status-badge badge-inactive">
                                                    🟠 Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Details" asp-route-id="@discharge.Id"
                                                   class="btn-action btn-details">
                                                    <span>👁️</span>
                                                    <span>View</span>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@discharge.Id"
                                                   class="btn-action btn-edit">
                                                    <span>✏️</span>
                                                    <span>Edit</span>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@discharge.Id"
                                                   class="btn-action btn-delete">
                                                    <span>🗑️</span>
                                                    <span>Remove</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    animationDelay += 0.1;

                                }
                            }

                            else

                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="text-center py-5">
                                            <div class="empty-state-icon" style="font-size: 4rem; opacity: 0.7;">📋</div>
                                            <h3 class="fw-bold text-dark mb-3">No Discharge Records</h3>
                                            <p class="text-muted fs-6 mb-4">Start by adding the first discharge record</p>
                                            <a asp-action="Create" class="btn-primary-glow">
                                                <span>➕</span>
                                                <span>Add First Discharge</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Professional Info Modal -->
