@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Enhanced table row interactions
            document.querySelectorAll('.professional-table-row').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (!e.target.closest('a')) {
                        this.style.background = 'linear-gradient(135deg, #f9f0ff 0%, #ffeef0 100%)';
                        setTimeout(() => {
                                this.style.background = '';
                                }, 500);
                            }
                        });
                    });

                    // Status badge hover effects
                    document.querySelectorAll('.status-badge').forEach(badge => {
                        badge.addEventListener('mouseenter', function () {
                            this.style.transform = 'translateY(-2px) scale(1.05)';
                            this.style.boxShadow = '0 8px 20px rgba(0, 0, 0, 0.25)';
                        });

                        badge.addEventListener('mouseleave', function () {
                            this.style.transform = 'translateY(0) scale(1)';
                            this.style.boxShadow = '0 4px 15px rgba(243, 156, 18, 0.3)';
                        });
                    });

                    // Patient avatar interactions
                    document.querySelectorAll('.patient-avatar').forEach(avatar => {
                        avatar.addEventListener('mouseenter', function () {
                            this.style.transform = 'scale(1.1) rotate(5deg)';
                        });

                        avatar.addEventListener('mouseleave', function () {
                            this.style.transform = 'scale(1) rotate(0deg)';
                        });
                    });

                    // Auto-dismiss success message after 5 seconds
                    setTimeout(() => {
                        const alert = document.querySelector('.success-alert');
                        if (alert) {
                            alert.style.opacity = '0';
                            alert.style.transform = 'translateY(-20px)';
                            setTimeout(() => {
                                if (alert.parentElement) {
                                    alert.parentElement.removeChild(alert);
                                }
                            }, 300);
                        }
                    }, 5000);

                    // Auto-refresh simulation for live data
                    setInterval(() => {
                        console.log('🔄 Checking for discharge updates...');
                        // In a real application, this would fetch updated data
                        updateLiveIndicators();
                    }, 30000);

                    function updateLiveIndicators() {
                        // Update any live indicators
                        document.querySelectorAll('.pulse-animation').forEach(element => {
                            element.style.animation = 'none';
                            setTimeout(() => {
                                element.style.animation = 'pulse 2.5s infinite';
                            }, 10);
                        });
                    }
                });
    </script>
}