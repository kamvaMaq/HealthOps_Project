@model HealthOps_Project.Models.Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<style>
    .doctor-details-container {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 50%, #F27121 100%);
        min-height: 100vh;
        padding: 40px 0;
        position: relative;
        overflow: hidden;
    }

        .doctor-details-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 30%, rgba(138, 35, 135, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(233, 64, 87, 0.2) 0%, transparent 50%), radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
            animation: floatBackground 20s ease-in-out infinite;
        }

    .professional-glass-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(25px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        overflow: hidden;
        position: relative;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        max-width: 700px;
        margin: 0 auto;
    }

    .professional-header {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .professional-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            animation: professionalShimmer 4s infinite;
        }

    .details-content {
        padding: 40px;
    }

    .detail-section {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 25px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
    }

        .detail-section:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

        .detail-item:hover {
            background: rgba(138, 35, 135, 0.05);
            border-radius: 8px;
            padding-left: 10px;
            padding-right: 10px;
        }

    .detail-label {
        font-weight: 700;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        font-weight: 500;
        color: #8A2387;
        text-align: right;
    }

    .detail-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        border-radius: 50%;
        color: white;
        font-size: 0.9rem;
    }

    .doctor-avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1.8rem;
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        margin: 0 auto 20px;
        box-shadow: 0 8px 25px rgba(138, 35, 135, 0.3);
        transition: all 0.3s ease;
    }

        .doctor-avatar-large:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 12px 30px rgba(138, 35, 135, 0.4);
        }

    .specialty-badge-large {
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 1rem;
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        transition: all 0.3s ease;
    }

        .specialty-badge-large:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #8A2387 0%, #E94057 100%);
        border: none;
        border-radius: 15px;
        padding: 14px 32px;
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 8px 20px rgba(138, 35, 135, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(138, 35, 135, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 14px 32px;
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 2px solid rgba(138, 35, 135, 0.1);
    }

    /* Animations */
    @@keyframes floatBackground {
        0%, 100% {
            transform: translate(0px, 0px) scale(1);
        }

        33% {
            transform: translate(20px, -15px) scale(1.02);
        }

        66% {
            transform: translate(-15px, 10px) scale(0.98);
        }
    }

    @@keyframes professionalShimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(25px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .animate-slide-in {
        animation: slideIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }
</style>

<div class="doctor-details-container">
    <div class="container">
        <div class="professional-glass-card mb-5 animate-slide-in">
            <!-- Professional Header -->
            <div class="professional-header">
                <div class="doctor-avatar-large">
                    @Model.FirstName?[0]@Model.LastName?[0]
                </div>
                <h1 class="display-5 fw-bold mb-2">Doctor Details</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete professional information and contact details</p>
            </div>

            <!-- Details Content -->
            <div class="details-content">
                <!-- Personal Information Section -->
                <div class="detail-section animate-slide-in" style="animation-delay: 0.2s;">
                    <h4 class="mb-4 text-primary">
                        <span class="detail-icon">👤</span>
                        Professional Information
                    </h4>
                    <div class="detail-item">
                        <span class="detail-label">Full Name</span>
                        <span class="detail-value">Dr. @Model.FirstName @Model.LastName</span>
                    </div>
                  @*   <div class="detail-item">
                        <span class="detail-label">Doctor ID</span>
                        <span class="detail-value">@Model.DoctorId</span>
                    </div> *@
                    <div class="detail-item">
                        <span class="detail-label">Medical Specialty</span>
                        <span class="detail-value">
                            <span class="specialty-badge-large">@Model.Specialty</span>
                        </span>
                    </div>
                </div>

                <!-- Contact Information Section -->
                <div class="detail-section animate-slide-in" style="animation-delay: 0.3s;">
                    <h4 class="mb-4 text-primary">
                        <span class="detail-icon">📞</span>
                        Contact Information
                    </h4>
                    <div class="detail-item">
                        <span class="detail-label">Phone Number</span>
                        <span class="detail-value">@Model.PhoneNumber</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Availability</span>
                        <span class="detail-value">
                            <span style="color: #27ae60; font-weight: 600;">🟢 Available</span>
                        </span>
                    </div>
                </div>

                <!-- Professional Statistics Section -->
                <div class="detail-section animate-slide-in" style="animation-delay: 0.4s;">
                    <h4 class="mb-4 text-primary">
                        <span class="detail-icon">📊</span>
                        Professional Statistics
                    </h4>
                    <div class="detail-item">
                        <span class="detail-label">Years of Service</span>
                        <span class="detail-value">5+ years</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Patient Satisfaction</span>
                        <span class="detail-value">⭐ 4.8/5.0</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Department</span>
                        <span class="detail-value">Medical Staff</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons animate-slide-in" style="animation-delay: 0.5s;">
                    <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn-primary-glow">
                        <span>✏️</span>
                        <span>Edit Doctor</span>
                    </a>
                    <a asp-action="Index" class="btn-secondary-glow">
                        <span>⬅️</span>
                        <span>Back to List</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Enhanced doctor avatar interaction
            const doctorAvatar = document.querySelector('.doctor-avatar-large');
            if (doctorAvatar) {
                doctorAvatar.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.1) rotate(5deg)';
                });

                doctorAvatar.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1) rotate(0deg)';
                });
            }

            // Specialty badge interaction
            const specialtyBadge = document.querySelector('.specialty-badge-large');
            if (specialtyBadge) {
                specialtyBadge.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px) scale(1.05)';
                });

                specialtyBadge.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            }

            // Detail items hover effects
            document.querySelectorAll('.detail-item').forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.background = 'rgba(138, 35, 135, 0.05)';
                    this.style.paddingLeft = '10px';
                    this.style.paddingRight = '10px';
                });

                item.addEventListener('mouseleave', function() {
                    this.style.background = '';
                    this.style.paddingLeft = '';
                    this.style.paddingRight = '';
                });
            });
        });
    </script>
}