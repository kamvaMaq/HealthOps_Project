@model HealthOps_Project.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 900px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">👁️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Employee Details</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete employee information and employment details</p>
            </div>

            <div class="p-4">
                <!-- Status Badge -->
                <div class="professional-stat-card mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold text-dark mb-2">@Model.FullName</h4>
                            <div class="d-flex flex-wrap gap-3">
                                @{
                                    var statusBadgeClass = "professional-badge-completed";
                                    if (Model.Status.ToString().Contains("Terminated") || Model.Status.ToString().Contains("Suspended"))
                                    {
                                        statusBadgeClass = "professional-badge-urgent";
                                    }
                                    else if (Model.Status.ToString().Contains("Leave"))
                                    {
                                        statusBadgeClass = "professional-badge-warning";
                                    }
                                }
                                <span class="professional-status-badge @statusBadgeClass">
                                    @Model.Status
                                </span>
                                <span class="professional-status-badge professional-badge-completed">
                                    @Model.Role
                                </span>
                                <span class="text-muted">
                                    📧 @Model.Email
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="professional-entity-icon professional-pulse" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); margin: 0 auto;">
                                👤
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="row g-4">
                    <!-- Personal Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">👤</span>
                                Personal Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Full Name</small>
                                    <div class="fw-bold text-dark">@Model.FullName</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">ID Number</small>
                                    <div class="fw-bold text-dark">
                                        <code class="bg-light px-2 py-1 rounded">@Model.IdNumber</code>
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Email</small>
                                    <div class="fw-bold text-dark">
                                        <a href="mailto:@Model.Email" class="text-decoration-none">📧 @Model.Email</a>
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Phone Number</small>
                                    <div class="fw-bold text-dark">
                                        <a href="tel:@Model.PhoneNumber" class="text-decoration-none">📞 @Model.PhoneNumber</a>
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Emergency Contact</small>
                                    <div class="fw-bold text-dark">
                                        @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                                        {
                                            @Model.EmergencyContact
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Employment Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">🏥</span>
                                Employment Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Role</small>
                                    <div class="fw-bold text-dark">@Model.Role</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Department</small>
                                    <div class="fw-bold text-dark">@Model.DepartmentName</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Ward</small>
                                    <div class="fw-bold text-dark">@Model.WardName</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Hire Date</small>
                                    <div class="fw-bold text-dark">
                                        @if (Model.HireDate != DateTime.MinValue)
                                        {
                                            @Model.HireDate.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Termination Date</small>
                                    <div class="fw-bold text-dark">
                                        @if (Model.TerminationDate.HasValue)
                                        {
                                            @Model.TerminationDate.Value.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not terminated</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Information -->
                    <div class="col-12">
                        <div class="professional-info-card">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">🎓</span>
                                Professional Information
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="space-y-3">
                                        <div>
                                            <small class="text-muted fw-semibold">License Number</small>
                                            <div class="fw-bold text-dark">
                                                @if (!string.IsNullOrEmpty(Model.LicenseNumber))
                                                {
                                                    <code class="bg-light px-2 py-1 rounded">@Model.LicenseNumber</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <small class="text-muted fw-semibold">Specialization</small>
                                            <div class="fw-bold text-dark">
                                                @if (!string.IsNullOrEmpty(Model.Specialization))
                                                {
                                                    @Model.Specialization
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <small class="text-muted fw-semibold">Qualifications</small>
                                        <div class="fw-bold text-dark">
                                            @if (!string.IsNullOrEmpty(Model.Qualifications))
                                            {
                                                @Model.Qualifications
                                            }
                                            else
                                            {
                                                <span class="text-muted">No qualifications specified</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📋</span>
                                    Additional Notes
                                </h6>
                                <div class="bg-light rounded-3 p-4">
                                    <p class="mb-0 text-dark fs-6 lh-base">@Model.Notes</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-5 pt-4 border-top">
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn-professional-primary">
                            <span>✏️</span>
                            <span>Edit Employee</span>
                        </a>
                        <a asp-action="Index" class="btn-professional-secondary">
                            <span>📋</span>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>