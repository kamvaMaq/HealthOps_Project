@model HealthOps_Project.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">✏️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Edit Employee</h1>
                <p class="lead mb-0 fs-6 opacity-90">Update employee information and employment details</p>
            </div>

            <div class="p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                    <input type="hidden" asp-for="EmployeeId" />

                    <div class="row g-4">
                        <!-- Personal Information -->
                        <div class="col-md-6">
                            <div class="professional-info-card h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">👤</span>
                                    Personal Information
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="professional-form-label">First Name</label>
                                    <input asp-for="FirstName" class="form-control professional-form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="LastName" class="professional-form-label">Last Name</label>
                                    <input asp-for="LastName" class="form-control professional-form-control" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IdNumber" class="professional-form-label">ID Number</label>
                                    <input asp-for="IdNumber" class="form-control professional-form-control" />
                                    <span asp-validation-for="IdNumber" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Email" class="professional-form-label">Email</label>
                                    <input asp-for="Email" class="form-control professional-form-control" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="professional-form-label">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control professional-form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="EmergencyContact" class="professional-form-label">Emergency Contact</label>
                                    <input asp-for="EmergencyContact" class="form-control professional-form-control" />
                                    <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Employment Details -->
                        <div class="col-md-6">
                            <div class="professional-info-card h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🏥</span>
                                    Employment Details
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="Role" class="professional-form-label">Role</label>
                                    <select asp-for="Role" class="form-control professional-form-control" asp-items="Html.GetEnumSelectList<HealthOps_Project.Models.EmployeeRoleType>()">
                                        <option value="">-- Select Role --</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="DepartmentName" class="professional-form-label">Department</label>
                                    <input asp-for="DepartmentName" class="form-control professional-form-control" />
                                    <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="WardName" class="professional-form-label">Ward</label>
                                    <input asp-for="WardName" class="form-control professional-form-control" />
                                    <span asp-validation-for="WardName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Status" class="professional-form-label">Employment Status</label>
                                    <select asp-for="Status" class="form-control professional-form-control" asp-items="Html.GetEnumSelectList<HealthOps_Project.Models.EmploymentStatus>()">
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="HireDate" class="professional-form-label">Hire Date</label>
                                    <input asp-for="HireDate" type="date" class="form-control professional-form-control" />
                                    <span asp-validation-for="HireDate" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="TerminationDate" class="professional-form-label">Termination Date</label>
                                    <input asp-for="TerminationDate" type="date" class="form-control professional-form-control" />
                                    <span asp-validation-for="TerminationDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Information -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🎓</span>
                                    Professional Information
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="Qualifications" class="professional-form-label">Qualifications</label>
                                    <textarea asp-for="Qualifications" class="form-control professional-form-control" rows="3"></textarea>
                                    <span asp-validation-for="Qualifications" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="LicenseNumber" class="professional-form-label">License Number</label>
                                    <input asp-for="LicenseNumber" class="form-control professional-form-control" />
                                    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Specialization" class="professional-form-label">Specialization</label>
                                    <input asp-for="Specialization" class="form-control professional-form-control" />
                                    <span asp-validation-for="Specialization" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📋</span>
                                    Additional Information
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="Notes" class="professional-form-label">Notes</label>
                                    <textarea asp-for="Notes" class="form-control professional-form-control" rows="3"></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <button type="submit" class="btn-professional-primary">
                                <span>💾</span>
                                <span>Save Changes</span>
                            </button>
                            <a asp-action="Index" class="btn-professional-secondary">
                                <span>↩️</span>
                                <span>Back to List</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

