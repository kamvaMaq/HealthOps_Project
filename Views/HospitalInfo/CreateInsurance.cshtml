@model HealthOps_Project.Models.InsurancePartnership
@{
    ViewData["Title"] = "Add Insurance Partnership";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 700px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">➕</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Add Insurance Partnership</h1>
                <p class="lead mb-0 fs-6 opacity-90">Create new insurance partnership for the hospital</p>
            </div>

            <div class="p-4">
                <form asp-action="CreateInsurance" method="post">
                    <input type="hidden" asp-for="HospitalId" value="@ViewBag.HospitalId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                    <div class="row g-4">
                        <!-- Partnership Details -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🏢</span>
                                    Partnership Details
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="InsuranceProvider" class="professional-form-label">Insurance Provider</label>
                                    <input asp-for="InsuranceProvider" class="form-control professional-form-control" placeholder="Enter insurance provider name" required />
                                    <span asp-validation-for="InsuranceProvider" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="SchemeName" class="professional-form-label">Scheme Name</label>
                                    <input asp-for="SchemeName" class="form-control professional-form-control" placeholder="Enter insurance scheme name" required />
                                    <span asp-validation-for="SchemeName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ProviderCode" class="professional-form-label">Provider Code</label>
                                    <input asp-for="ProviderCode" class="form-control professional-form-control" placeholder="Enter provider code (optional)" />
                                    <span asp-validation-for="ProviderCode" class="text-danger small"></span>
                                    <small class="form-text text-muted">Optional provider code or reference number</small>
                                </div>
                            </div>
                        </div>

                        <!-- Contract Dates -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📅</span>
                                    Contract Period
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ContractStartDate" class="professional-form-label">Contract Start Date</label>
                                            <input asp-for="ContractStartDate" class="form-control professional-form-control" type="date" />
                                            <span asp-validation-for="ContractStartDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ContractEndDate" class="professional-form-label">Contract End Date</label>
                                            <input asp-for="ContractEndDate" class="form-control professional-form-control" type="date" />
                                            <span asp-validation-for="ContractEndDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Notes -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">⚙️</span>
                                    Status & Additional Information
                                </h6>
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked style="transform: scale(1.3); margin-right: 10px;">
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Partnership</label>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Notes" class="professional-form-label">Notes</label>
                                    <textarea asp-for="Notes" class="form-control professional-form-control" rows="3" placeholder="Enter any additional notes or comments"></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <button type="submit" class="btn-professional-success">
                                <span>💾</span>
                                <span>Add Partnership</span>
                            </button>
                            <a asp-action="ManageInsurance" asp-route-id="@ViewBag.HospitalId" class="btn-professional-secondary">
                                <span>↩️</span>
                                <span>Cancel</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}