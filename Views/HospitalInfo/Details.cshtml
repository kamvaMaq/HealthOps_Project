@model HealthOps_Project.Models.HospitalInfo
@{
    ViewData["Title"] = "Hospital Details";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 1000px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #8e44ad 0%, #9b59b6 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🏥</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Hospital Details</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete hospital information and insurance partnerships</p>
            </div>

            <div class="p-4">
                <!-- Hospital Information -->
                <div class="professional-info-card mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <span class="me-2">📋</span>
                        Hospital Information
                    </h6>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Hospital Name</small>
                                    <div class="fw-bold text-dark">@Model.HospitalName</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Address</small>
                                    <div class="fw-bold text-dark">@Model.Address</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">City</small>
                                    <div class="fw-bold text-dark">@Model.City</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Province</small>
                                    <div class="fw-bold text-dark">@Model.Province</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Postal Code</small>
                                    <div class="fw-bold text-dark">@Model.PostalCode</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Main Phone</small>
                                    <div class="fw-bold text-dark">
                                        <a href="tel:@Model.MainPhone" class="text-decoration-none">📞 @Model.MainPhone</a>
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Email</small>
                                    <div class="fw-bold text-dark">
                                        <a href="mailto:@Model.Email" class="text-decoration-none">📧 @Model.Email</a>
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">24/7 Operation</small>
                                    <div class="fw-bold text-dark">
                                        @if (Model.Is24Hour)
                                        {
                                            <span class="professional-status-badge professional-badge-completed">✅ Yes</span>
                                        }
                                        else
                                        {
                                            <span class="professional-status-badge professional-badge-warning">❌ No</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="text-center mb-4">
                    <a asp-action="Edit" asp-route-id="@Model.HospitalId" class="btn-professional-primary">
                        <span>✏️</span>
                        <span>Edit Hospital Info</span>
                    </a>
                </div>

                <!-- Insurance Partnerships Section -->
                <div class="professional-info-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold text-dark mb-0">
                            <span class="me-2">🛡️</span>
                            Insurance Partnerships
                        </h6>
                        <button class="btn-professional-success" data-bs-toggle="modal" data-bs-target="#createInsuranceModal">
                            <span>➕</span>
                            <span>Add Insurance Partnership</span>
                        </button>
                    </div>

                    @if (Model.InsurancePartnerships != null && Model.InsurancePartnerships.Any())
                    {
                        <div class="professional-table-container">
                            <table class="table professional-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Insurance Provider</th>
                                        <th>Scheme Name</th>
                                        <th>Provider Code</th>
                                        <th>Status</th>
                                        <th style="width: 200px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var partnership in Model.InsurancePartnerships)
                                    {
                                        <tr>
                                            <td class="fw-bold">@partnership.InsuranceProvider</td>
                                            <td>@partnership.SchemeName</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(partnership.ProviderCode))
                                                {
                                                    <code class="bg-light px-2 py-1 rounded">@partnership.ProviderCode</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (partnership.IsActive)
                                                {
                                                    <span class="professional-status-badge professional-badge-completed">
                                                        ✅ Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="professional-status-badge professional-badge-warning">
                                                        ⏳ Inactive
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2 flex-wrap">
                                                    <button class="btn-professional-primary" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#editInsuranceModal@partnership.PartnershipId">
                                                        <span>✏️</span>
                                                        <span>Edit</span>
                                                    </button>
                                                    <form asp-action="DeleteInsurance" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@partnership.PartnershipId" />
                                                        <input type="hidden" name="hospitalId" value="@Model.HospitalId" />
                                                        <button type="submit" class="btn-professional-danger" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;"
                                                                onclick="return confirm('Are you sure you want to delete this partnership?')">
                                                            <span>🗑️</span>
                                                            <span>Delete</span>
                                                        </button>
                                                    </form>
                                                </div>

                                                <!-- Edit Insurance Modal -->
                                                <div class="modal fade" id="editInsuranceModal@partnership.PartnershipId" tabindex="-1" aria-labelledby="editInsuranceLabel@partnership.PartnershipId" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold" id="editInsuranceLabel@partnership.PartnershipId">
                                                                    <span class="me-2">✏️</span>
                                                                    Edit Insurance Partnership
                                                                </h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <form asp-action="EditInsurance" method="post">
                                                                    <input type="hidden" name="PartnershipId" value="@partnership.PartnershipId" />
                                                                    <input type="hidden" name="HospitalId" value="@Model.HospitalId" />

                                                                    <div class="mb-3">
                                                                        <label class="professional-form-label">Insurance Provider</label>
                                                                        <input name="InsuranceProvider" class="form-control professional-form-control" value="@partnership.InsuranceProvider" required />
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="professional-form-label">Scheme Name</label>
                                                                        <input name="SchemeName" class="form-control professional-form-control" value="@partnership.SchemeName" required />
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="professional-form-label">Provider Code</label>
                                                                        <input name="ProviderCode" class="form-control professional-form-control" value="@partnership.ProviderCode" />
                                                                    </div>
                                                                    <div class="form-check form-switch mb-3">
                                                                        <input type="checkbox" class="form-check-input" name="IsActive" value="true"
                                                                        @(partnership.IsActive ? "checked" : "") style="transform: scale(1.3); margin-right: 10px;">
                                                                        <label class="form-check-label fw-semibold">Active Partnership</label>
                                                                    </div>
                                                                    <div class="d-grid gap-2">
                                                                        <button type="submit" class="btn-professional-primary">
                                                                            <span>💾</span>
                                                                            <span>Save Changes</span>
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <!-- Empty State -->
                        <div class="text-center py-5">
                            <div class="professional-entity-icon" style="background: linear-gradient(135deg, #6c757d 0%, #495057 100%); margin: 0 auto 1rem; width: 80px; height: 80px;">
                                🛡️
                            </div>
                            <h4 class="fw-bold text-dark mb-3">No Insurance Partnerships</h4>
                            <p class="text-muted mb-4">Get started by adding your first insurance partnership.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Insurance Modal -->
<div class="modal fade" id="createInsuranceModal" tabindex="-1" aria-labelledby="createInsuranceLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createInsuranceLabel">
                    <span class="me-2">➕</span>
                    Add Insurance Partnership
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateInsurance" method="post">
                    <input type="hidden" name="HospitalId" value="@Model.HospitalId" />

                    <div class="mb-3">
                        <label class="professional-form-label">Insurance Provider</label>
                        <input name="InsuranceProvider" class="form-control professional-form-control" placeholder="Enter insurance provider name" required />
                    </div>
                    <div class="mb-3">
                        <label class="professional-form-label">Scheme Name</label>
                        <input name="SchemeName" class="form-control professional-form-control" placeholder="Enter insurance scheme name" required />
                    </div>
                    <div class="mb-3">
                        <label class="professional-form-label">Provider Code</label>
                        <input name="ProviderCode" class="form-control professional-form-control" placeholder="Enter provider code (optional)" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" name="IsActive" checked style="transform: scale(1.3); margin-right: 10px;">
                        <label class="form-check-label fw-semibold">Active Partnership</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn-professional-success">
                            <span>💾</span>
                            <span>Add Insurance</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add loading states to form submissions
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        const originalText = submitBtn.innerHTML;
                        submitBtn.innerHTML = '<span class="professional-loading"></span><span>Processing...</span>';
                        submitBtn.disabled = true;

                        setTimeout(() => {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }, 3000);
                    }
                });
            });

            // Enhance modal animations
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                modal.addEventListener('show.bs.modal', function () {
                    this.querySelector('.modal-content').style.transform = 'scale(0.9)';
                    this.querySelector('.modal-content').style.opacity = '0';
                });
                modal.addEventListener('shown.bs.modal', function () {
                    this.querySelector('.modal-content').style.transform = 'scale(1)';
                    this.querySelector('.modal-content').style.opacity = '1';
                    this.querySelector('.modal-content').style.transition = 'all 0.3s ease';
                });
            });
        });
    </script>
}