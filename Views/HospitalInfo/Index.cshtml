@model HealthOps_Project.Models.HospitalInfo
@{
    ViewData["Title"] = "Hospital Information";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #8e44ad 0%, #9b59b6 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🏥</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">@Model.HospitalName</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete hospital information and facility details</p>
            </div>


            <a asp-controller="Dashboard" asp-action="Admin" class="btn-professional-secondary">
                <span>📊</span>
                <span>Dashboard</span>
            </a>

            <div class="p-4">
                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">✅</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Success!</h5>
                                <p class="mb-0">@TempData["SuccessMessage"]</p>
                            </div>
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">❌</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Error</h5>
                                <p class="mb-0">@TempData["ErrorMessage"]</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.HospitalId" class="btn-professional-primary">
                            <span>✏️</span>
                            <span>Edit Information</span>
                        </a>
                        <a asp-action="ManageInsurance" asp-route-id="@Model.HospitalId" class="btn-professional-success">
                            <span>🛡️</span>
                            <span>Manage Insurance</span>
                        </a>
                    </div>
                </div>

                <!-- Hospital Information Grid -->
                <div class="row g-4">
                    <!-- Basic Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">📋</span>
                                Basic Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Hospital Name</small>
                                    <div class="fw-bold text-dark">@Model.HospitalName</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Address</small>
                                    <div class="fw-bold text-dark">
                                        @Model.Address<br />
                                        @Model.City, @Model.Province<br />
                                        @Model.PostalCode
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Main Phone</small>
                                    <div class="fw-bold text-dark">
                                        <a href="tel:@Model.MainPhone" class="text-decoration-none">📞 @Model.MainPhone</a>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.EmergencyPhone))
                                {
                                    <div>
                                        <small class="text-muted fw-semibold">Emergency Phone</small>
                                        <div class="fw-bold text-dark">
                                            <a href="tel:@Model.EmergencyPhone" class="text-decoration-none text-danger">🚨 @Model.EmergencyPhone</a>
                                        </div>
                                    </div>
                                }
                                <div>
                                    <small class="text-muted fw-semibold">Email</small>
                                    <div class="fw-bold text-dark">
                                        <a href="mailto:@Model.Email" class="text-decoration-none">📧 @Model.Email</a>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Website))
                                {
                                    <div>
                                        <small class="text-muted fw-semibold">Website</small>
                                        <div class="fw-bold text-dark">
                                            <a href="@Model.Website" target="_blank" class="text-decoration-none">🌐 @Model.Website</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Facility Details -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">🏢</span>
                                Facility Details
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Operating Hours</small>
                                    <div class="fw-bold text-dark">
                                        @Model.OperatingHours
                                        @if (Model.Is24Hour)
                                        {
                                            <span class="professional-status-badge professional-badge-completed ms-2">24/7</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted fw-semibold">Total Beds</small>
                                        <div class="fw-bold text-dark fs-5">🛏️ @Model.TotalBeds</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted fw-semibold">ICU Beds</small>
                                        <div class="fw-bold text-dark fs-5">💙 @Model.ICUBeds</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted fw-semibold">Emergency Beds</small>
                                        <div class="fw-bold text-dark fs-5">🚑 @Model.EmergencyBeds</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.RegistrationNumber))
                                {
                                    <div>
                                        <small class="text-muted fw-semibold">Registration Number</small>
                                        <div class="fw-bold text-dark">@Model.RegistrationNumber</div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.HealthFacilityCode))
                                {
                                    <div>
                                        <small class="text-muted fw-semibold">Facility Code</small>
                                        <div class="fw-bold text-dark">@Model.HealthFacilityCode</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Accreditation -->
                    @if (!string.IsNullOrEmpty(Model.AccreditationBody) || Model.AccreditationDate.HasValue)
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🏆</span>
                                    Accreditation
                                </h6>
                                <div class="row">
                                    @if (!string.IsNullOrEmpty(Model.AccreditationBody))
                                    {
                                        <div class="col-md-6">
                                            <small class="text-muted fw-semibold">Accreditation Body</small>
                                            <div class="fw-bold text-dark">@Model.AccreditationBody</div>
                                        </div>
                                    }
                                    @if (Model.AccreditationDate.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <small class="text-muted fw-semibold">Accreditation Date</small>
                                            <div class="fw-bold text-dark">@Model.AccreditationDate.Value.ToString("MMMM dd, yyyy")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Insurance Partnerships -->
                    @if (Model.InsurancePartnerships != null && Model.InsurancePartnerships.Any())
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🛡️</span>
                                    Insurance Partnerships
                                </h6>
                                <div class="row g-3">
                                    @foreach (var partnership in Model.InsurancePartnerships.Where(p => p.IsActive).Take(6))
                                    {
                                        <div class="col-md-4">
                                            <div class="professional-stat-card">
                                                <div class="fw-bold text-dark">@partnership.InsuranceProvider</div>
                                                <small class="text-muted">@partnership.SchemeName</small>
                                                @if (!string.IsNullOrEmpty(partnership.ProviderCode))
                                                {
                                                    <div class="mt-1">
                                                        <code class="bg-light px-2 py-1 rounded small">@partnership.ProviderCode</code>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (Model.InsurancePartnerships.Count() > 6)
                                {
                                    <p class="mb-0 mt-3 text-center">
                                        <small class="text-muted">And @(Model.InsurancePartnerships.Count() - 6) more partnerships...</small>
                                    </p>
                                }
                                <div class="text-center mt-3">
                                    <a asp-action="ManageInsurance" asp-route-id="@Model.HospitalId" class="btn-professional-secondary">
                                        <span>👁️</span>
                                        <span>View All Partnerships</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Mission Statement -->
                    @if (!string.IsNullOrEmpty(Model.MissionStatement))
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🎯</span>
                                    Mission Statement
                                </h6>
                                <div class="bg-light rounded-3 p-4">
                                    <p class="mb-0 text-dark fs-6 lh-base">@Model.MissionStatement</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Timestamps -->
                <div class="text-center mt-5 pt-4 border-top">
                    <div class="text-muted small">
                        <p class="mb-1">Created: @Model.CreatedDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <p class="mb-0">Last Modified: @Model.ModifiedDate.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>