@model IEnumerable<HealthOps_Project.Models.InsurancePartnership>
@{
    ViewData["Title"] = "Manage Insurance Partnerships";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🛡️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Insurance Partnerships</h1>
                <p class="lead mb-0 fs-6 opacity-90">Manage hospital insurance partnerships and contracts</p>
            </div>

            <div class="p-4">
                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">✅</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Success!</h5>
                                <p class="mb-0">@TempData["SuccessMessage"]</p>
                            </div>
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">❌</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Error</h5>
                                <p class="mb-0">@TempData["ErrorMessage"]</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <a asp-action="CreateInsurance" asp-route-hospitalId="@ViewBag.HospitalId" class="btn-professional-success">
                        <span>➕</span>
                        <span>Add New Partnership</span>
                    </a>
                    <a asp-action="Index" class="btn-professional-secondary">
                        <span>↩️</span>
                        <span>Back to Hospital Info</span>
                    </a>
                </div>

                @if (Model != null && Model.Any())
                {
                    <!-- Partnerships Table -->
                    <div class="professional-table-container">
                        <table class="table professional-table">
                            <thead class="table-dark">
                                <tr>
                                    <th>Insurance Provider</th>
                                    <th>Scheme Name</th>
                                    <th>Provider Code</th>
                                    <th>Status</th>
                                    <th>Contract Start</th>
                                    <th>Contract End</th>
                                    <th style="width: 200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.InsuranceProvider</td>
                                        <td>@item.SchemeName</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ProviderCode))
                                            {
                                                <code class="bg-light px-2 py-1 rounded">@item.ProviderCode</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="professional-status-badge professional-badge-completed">
                                                    ✅ Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="professional-status-badge professional-badge-warning">
                                                    ⏳ Inactive
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <small>@(item.ContractStartDate?.ToString("MMM dd, yyyy") ?? "-")</small>
                                        </td>
                                        <td>
                                            <small>@(item.ContractEndDate?.ToString("MMM dd, yyyy") ?? "-")</small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a asp-action="EditInsurance" asp-route-id="@item.PartnershipId"
                                                   class="btn-professional-primary" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;">
                                                    <span>✏️</span>
                                                    <span>Edit</span>
                                                </a>
                                                <button type="button" class="btn-professional-danger" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal@(item.PartnershipId)">
                                                    <span>🗑️</span>
                                                    <span>Delete</span>
                                                </button>
                                            </div>

                                            <!-- Delete Confirmation Modal -->
                                            <div class="modal fade" id="deleteModal@(item.PartnershipId)" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">Confirm Delete</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="alert alert-warning rounded-3">
                                                                <div class="d-flex align-items-center">
                                                                    <span class="fs-4 me-3">⚠️</span>
                                                                    <div>
                                                                        <h6 class="alert-heading fw-bold mb-2">Warning</h6>
                                                                        <p class="mb-0">Are you sure you want to delete this partnership?</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="professional-info-card">
                                                                <strong>@item.InsuranceProvider</strong><br />
                                                                <small class="text-muted">@item.SchemeName</small>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn-professional-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-action="DeleteInsurance" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.PartnershipId" />
                                                                <input type="hidden" name="hospitalId" value="@ViewBag.HospitalId" />
                                                                <button type="submit" class="btn-professional-danger">Delete</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <tr>
                                            <td colspan="7" class="table-light">
                                                <div class="p-3">
                                                    <small class="text-muted fw-semibold">📝 Notes:</small>
                                                    <small class="text-dark">@item.Notes</small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <div class="professional-entity-icon" style="background: linear-gradient(135deg, #6c757d 0%, #495057 100%); margin: 0 auto 1rem; width: 80px; height: 80px;">
                            🛡️
                        </div>
                        <h4 class="fw-bold text-dark mb-3">No Insurance Partnerships</h4>
                        <p class="text-muted mb-4">Get started by adding your first insurance partnership.</p>
                        <a asp-action="CreateInsurance" asp-route-hospitalId="@ViewBag.HospitalId" class="btn-professional-success">
                            <span>➕</span>
                            <span>Add First Partnership</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>