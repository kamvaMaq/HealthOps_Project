@model HealthOps_Project.Models.MedicalCondition
@{
    ViewData["Title"] = "Create Medical Condition";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">➕</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Create Medical Condition</h1>
                <p class="lead mb-0 fs-6 opacity-90">Add new medical condition to the database</p>
            </div>

            <div class="p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                    <div class="row g-4">
                        <!-- Basic Information -->
                        <div class="col-md-6">
                            <div class="professional-info-card h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📋</span>
                                    Basic Information
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="ConditionName" class="professional-form-label">Condition Name</label>
                                    <input asp-for="ConditionName" class="form-control professional-form-control" placeholder="Enter condition name" />
                                    <span asp-validation-for="ConditionName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Category" class="professional-form-label">Category</label>
                                    <select asp-for="Category" class="form-control professional-form-control"
                                            asp-items="Html.GetEnumSelectList<HealthOps_Project.Models.ConditionCategory>()">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ICD10Code" class="professional-form-label">ICD-10 Code</label>
                                    <input asp-for="ICD10Code" class="form-control professional-form-control" placeholder="Enter ICD-10 code" />
                                    <span asp-validation-for="ICD10Code" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Monitoring -->
                        <div class="col-md-6">
                            <div class="professional-info-card h-100">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">⚙️</span>
                                    Status & Settings
                                </h6>
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="RequiresMonitoring" class="form-check-input" type="checkbox" role="switch" style="transform: scale(1.3); margin-right: 10px;">
                                    <label asp-for="RequiresMonitoring" class="form-check-label fw-semibold">Requires Monitoring</label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked style="transform: scale(1.3); margin-right: 10px;">
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Condition</label>
                                </div>
                                <div class="alert alert-info rounded-3 mt-3">
                                    <small>✅ New conditions are active by default. Uncheck to create as inactive.</small>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📝</span>
                                    Condition Description
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="Description" class="professional-form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control professional-form-control" rows="4" placeholder="Enter detailed description of the condition"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Treatment Guidelines -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">💊</span>
                                    Treatment Guidelines
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="TreatmentGuidelines" class="professional-form-label">Treatment Guidelines</label>
                                    <textarea asp-for="TreatmentGuidelines" class="form-control professional-form-control" rows="4" placeholder="Enter standard treatment guidelines"></textarea>
                                    <span asp-validation-for="TreatmentGuidelines" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Common Symptoms -->
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">🤒</span>
                                    Common Symptoms
                                </h6>
                                <div class="mb-3">
                                    <label asp-for="CommonSymptoms" class="professional-form-label">Common Symptoms</label>
                                    <textarea asp-for="CommonSymptoms" class="form-control professional-form-control" rows="4" placeholder="Enter common symptoms associated with this condition"></textarea>
                                    <span asp-validation-for="CommonSymptoms" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden Fields -->
                        <input type="hidden" asp-for="CreatedDate" value="@DateTime.Now" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <button type="submit" class="btn-professional-success">
                                <span>💾</span>
                                <span>Create Condition</span>
                            </button>
                            <a asp-action="Index" class="btn-professional-secondary">
                                <span>↩️</span>
                                <span>Cancel</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

