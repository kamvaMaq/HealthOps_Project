@model HealthOps_Project.Models.MedicalCondition
@{
    ViewData["Title"] = "Delete Medical Condition";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🗑️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Delete Medical Condition</h1>
                <p class="lead mb-0 fs-6 opacity-90">Permanently remove condition from database</p>
            </div>

            <div class="p-4">
                <!-- Warning Alert -->
                <div class="alert alert-danger rounded-3 mb-4">
                    <div class="d-flex align-items-center">
                        <span class="fs-4 me-3">⚠️</span>
                        <div>
                            <h5 class="alert-heading fw-bold mb-2">Warning: Irreversible Action</h5>
                            <p class="mb-0">You are about to permanently delete this medical condition. This action cannot be undone.</p>
                        </div>
                    </div>
                </div>

                <!-- Condition Summary -->
                <div class="professional-info-card mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <span class="me-2">📋</span>
                        Condition to Delete
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted fw-semibold">Condition Name</small>
                            <div class="fw-bold text-dark">@Model.ConditionName</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted fw-semibold">Category</small>
                            <div class="fw-bold text-dark">@Model.Category</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted fw-semibold">ICD-10 Code</small>
                            <div class="fw-bold text-dark">
                                <code class="bg-light px-2 py-1 rounded">@Model.ICD10Code</code>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted fw-semibold">Active Status</small>
                            <div class="fw-bold text-dark">@(Model.IsActive ? "Active" : "Inactive")</div>
                        </div>
                        <div class="col-12">
                            <small class="text-muted fw-semibold">Description</small>
                            <div class="fw-bold text-dark">@Model.Description</div>
                        </div>
                    </div>
                </div>

                <!-- Confirmation Form -->
                <div class="professional-info-card">
                    <h6 class="fw-bold text-dark mb-3">
                        <span class="me-2">✅</span>
                        Confirm Deletion
                    </h6>

                    <!-- ✅ Fixed form action -->
                    <form asp-action="Delete" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ConditionId" />

                        <div class="alert alert-warning rounded-3 mb-4">
                            <div class="d-flex align-items-center">
                                <span class="fs-5 me-3">💡</span>
                                <div>
                                    <p class="mb-0">Please confirm that you want to permanently delete this medical condition.</p>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-professional-danger"
                                onclick="return confirm('Are you absolutely sure? This action cannot be undone.')">
                            <span>🗑️</span>
                            <span>Permanently Delete</span>
                        </button>
                    </form>
                </div>

                <!-- Cancel Button -->
                <div class="text-center mt-4">
                    <a asp-action="Index" class="btn-professional-secondary">
                        <span>↩️</span>
                        <span>Cancel and Return</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


