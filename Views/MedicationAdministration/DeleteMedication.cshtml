@model HealthOps_Project.Models.Medication

@{
    ViewData["Title"] = "Delete Medication";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🗑️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Delete Medication</h1>
                <p class="lead mb-0 fs-6 opacity-90">Remove medication from active inventory</p>
            </div>

            <div class="p-4">
                <!-- Warning Alert -->
                <div class="alert alert-danger rounded-3 mb-4 border-0">
                    <div class="d-flex align-items-center">
                        <span class="fs-4 me-3">⚠️</span>
                        <div>
                            <h5 class="alert-heading fw-bold mb-2">Critical Action Required</h5>
                            <p class="mb-0">
                                You are about to mark this medication as inactive. This is a soft delete - the medication
                                record will be preserved but removed from active inventory. It can be restored later if needed.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Medication Summary -->
                <div class="professional-stat-card mb-4" style="border-left: 4px solid #e74c3c;">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold text-dark mb-2">@Model.Name</h4>
                            <div class="d-flex flex-wrap gap-3">
                                <span class="professional-status-badge @(Model.IsScheduledMedication() ? "professional-badge-warning" : "professional-badge-normal")">
                                    @(Model.IsScheduledMedication() ? "📅 Scheduled" : "💊 Non-Scheduled") (@Model.Schedule)
                                </span>
                                <span class="text-muted">
                                    📦 @Model.Quantity units
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="professional-entity-icon" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); margin: 0 auto;">
                                💊
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Preview -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">Medication Information</h6>
                            <div class="space-y-2">
                                <div>
                                    <small class="text-muted fw-semibold">Type</small>
                                    <div class="fw-bold text-dark">@Model.Type</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Schedule</small>
                                    <div class="fw-bold text-dark">
                                        @Model.Schedule - @(Model.IsScheduledMedication() ? "Scheduled" : "Non-Scheduled")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">Inventory Details</h6>
                            <div class="space-y-2">
                                <div>
                                    <small class="text-muted fw-semibold">Current Stock</small>
                                    <div class="fw-bold text-dark">@Model.Quantity units</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Expiry Date</small>
                                    <div class="fw-bold text-dark">@Model.ExpiryDate.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="professional-info-card mb-4">
                        <h6 class="fw-bold text-dark mb-3">Description</h6>
                        <div class="bg-light rounded-3 p-3">
                            <p class="mb-0 text-dark">@Model.Description</p>
                        </div>
                    </div>
                }

                <!-- Delete Form -->
                <form asp-action="DeleteMedication" method="post" class="text-center mt-5 pt-4 border-top">
                    <input type="hidden" asp-for="MedicationId" />

                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <button type="submit" class="btn-professional-action btn-professional-delete">
                            <span>🗑️</span>
                            <span>Confirm Delete</span>
                        </button>
                        <a asp-action="DetailsMedication" asp-route-id="@Model.MedicationId" class="btn-professional-secondary">
                            <span>👁️</span>
                            <span>View Details</span>
                        </a>
                        <a asp-action="Medications" class="btn-professional-secondary">
                            <span>📋</span>
                            <span>Back to List</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>