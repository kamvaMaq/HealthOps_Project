@model HealthOps_Project.Models.ScheduledMedication

@{
    ViewData["Title"] = "Delete Scheduled Medication";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">🗑️</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Delete Scheduled Medication</h1>
                <p class="lead mb-0 fs-6 opacity-90">Remove scheduled medication administration record</p>
            </div>

            <div class="p-4">
                <!-- Warning Alert -->
                <div class="alert alert-danger rounded-3 mb-4 border-0">
                    <div class="d-flex align-items-center">
                        <span class="fs-4 me-3">⚠️</span>
                        <div>
                            <h5 class="alert-heading fw-bold mb-2">Critical Action Required</h5>
                            <p class="mb-0">
                                You are about to permanently delete this scheduled medication administration record.
                                This action cannot be undone and will remove the schedule from the system.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Record Summary -->
                <div class="professional-stat-card mb-4" style="border-left: 4px solid #e74c3c;">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold text-dark mb-2">@Model.Medication?.Name</h4>
                            <div class="d-flex flex-wrap gap-3">
                                <span class="professional-status-badge professional-badge-warning">
                                    👤 @(Model.Patient?.LastName ?? "N/A")
                                </span>
                                <span class="text-muted">
                                    📅 @Model.AdministeredDate.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="professional-entity-icon" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); margin: 0 auto;">
                                📅
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Preview -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">Patient & Medication</h6>
                            <div class="space-y-2">
                                <div>
                                    <small class="text-muted fw-semibold">Patient</small>
                                    <div class="fw-bold text-dark">@(Model.Patient?.LastName ?? "N/A")</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Medication</small>
                                    <div class="fw-bold text-dark">@Model.Medication?.Name</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Schedule</small>
                                    <div class="fw-bold text-dark">
                                        <span class="professional-status-badge professional-badge-warning">
                                            @Model.Medication?.Schedule
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">Schedule Details</h6>
                            <div class="space-y-2">
                                <div>
                                    <small class="text-muted fw-semibold">Dosage</small>
                                    <div class="fw-bold text-dark">@Model.Dosage</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Scheduled Date</small>
                                    <div class="fw-bold text-dark">@Model.AdministeredDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Status</small>
                                    <div class="fw-bold text-dark">@Model.ScheduledMedicationStatus</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Form -->
                <form asp-action="DeleteScheduled" method="post" class="text-center mt-5 pt-4 border-top">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <button type="submit" class="btn-professional-action btn-professional-delete">
                            <span>🗑️</span>
                            <span>Confirm Delete</span>
                        </button>
                        <a asp-action="Scheduled" class="btn-professional-secondary">
                            <span>📋</span>
                            <span>Back to List</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
