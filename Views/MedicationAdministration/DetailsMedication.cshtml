@model HealthOps_Project.Models.Medication

@{
    ViewData["Title"] = "Medication Details";
    var isExpired = Model.ExpiryDate < DateTime.Today;
    var isExpiringSoon = Model.ExpiryDate <= DateTime.Today.AddMonths(3) && !isExpired;
    var isLowStock = Model.Quantity < 10 && Model.Quantity > 0;
    var isOutOfStock = Model.Quantity == 0;
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 900px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">💊</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Medication Details</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete medication information and inventory status</p>
            </div>

            <div class="p-4">
                <!-- Alert Warnings -->
                @if (isExpired)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">🚨</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Medication Expired</h5>
                                <p class="mb-0">This medication expired on @Model.ExpiryDate.ToString("MMM dd, yyyy"). Do not administer.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (isExpiringSoon)
                {
                    <div class="alert alert-warning rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">⚠️</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Expiring Soon</h5>
                                <p class="mb-0">This medication expires on @Model.ExpiryDate.ToString("MMM dd, yyyy").</p>
                            </div>
                        </div>
                    </div>
                }

                @if (isOutOfStock)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">📦</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Out of Stock</h5>
                                <p class="mb-0">This medication is currently unavailable. Please reorder.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (isLowStock)
                {
                    <div class="alert alert-warning rounded-3 mb-4">
                        <div class="d-flex align-items-center">
                            <span class="fs-4 me-3">📦</span>
                            <div>
                                <h5 class="alert-heading fw-bold mb-2">Low Stock Alert</h5>
                                <p class="mb-0">Only @Model.Quantity units remaining. Consider reordering soon.</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Medication Summary Card -->
                <div class="professional-stat-card mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold text-dark mb-2">@Model.Name</h4>
                            <div class="d-flex flex-wrap gap-3">
                                <span class="professional-status-badge @(Model.IsScheduledMedication() ? "professional-badge-warning" : "professional-badge-normal")">
                                    @(Model.IsScheduledMedication() ? "📅 Scheduled" : "💊 Non-Scheduled") (@Model.Schedule)
                                </span>
                                <span class="text-muted">
                                    🆔 ID: @Model.MedicationId
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="professional-entity-icon professional-pulse" style="margin: 0 auto;">
                                💊
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="row g-4">
                    <!-- Basic Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">📋</span>
                                Basic Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Medication Type</small>
                                    <div class="fw-bold text-dark">@Model.Type</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Schedule Classification</small>
                                    <div class="fw-bold text-dark">
                                        @Model.Schedule - @(Model.IsScheduledMedication() ? "Scheduled (5-7)" : "Non-Scheduled (1-4)")
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Current Status</small>
                                    <div>
                                        @if (Model.DeletionStatus == MedicationStatus.Active)
                                        {
                                            <span class="professional-status-badge professional-badge-normal">✅ Active</span>
                                        }
                                        else
                                        {
                                            <span class="professional-status-badge professional-badge-critical">🚨 Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Status -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">📦</span>
                                Inventory Status
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Quantity Available</small>
                                    <div class="fw-bold text-dark">@Model.Quantity units</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Expiry Date</small>
                                    <div class="fw-bold text-dark">@Model.ExpiryDate.ToString("dddd, MMMM dd, yyyy")</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Stock Status</small>
                                    <div>
                                        @if (isOutOfStock)
                                        {
                                            <span class="professional-status-badge professional-badge-critical">🚨 Out of Stock</span>
                                        }
                                        else if (isLowStock)
                                        {
                                            <span class="professional-status-badge professional-badge-warning">⚠️ Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="professional-status-badge professional-badge-normal">✅ In Stock</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📝</span>
                                    Description & Notes
                                </h6>
                                <div class="bg-light rounded-3 p-3">
                                    <p class="mb-0 text-dark">@Model.Description</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Administration Information -->
                    <div class="col-12">
                        <div class="professional-info-card">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">💡</span>
                                Administration Information
                            </h6>
                            <div class="alert @(Model.IsScheduledMedication() ? "alert-warning" : "alert-info") rounded-3">
                                <div class="d-flex align-items-center">
                                    <span class="fs-5 me-3">@(Model.IsScheduledMedication() ? "📅" : "💊")</span>
                                    <div>
                                        <h6 class="fw-bold mb-2">
                                            @(Model.IsScheduledMedication() ? "Scheduled Medication (Schedule 5-7)" : "Non-Scheduled Medication (Schedule 1-4)")
                                        </h6>
                                        <p class="mb-2">
                                            @(Model.IsScheduledMedication()
                                                ? "This medication requires scheduling and can be administered on future dates. It is a controlled substance that needs proper documentation and monitoring."
                                                : "This medication can be administered on the same day without advanced scheduling. It is available for immediate use when needed.")
                                        </p>
                                        <div class="mt-2">
                                            @if (Model.IsScheduledMedication())
                                            {
                                                <a asp-action="CreateScheduled" class="btn-professional-primary btn-sm">
                                                    <span>📅</span>
                                                    <span>Schedule Administration</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="CreateNonScheduled" class="btn-professional-primary btn-sm">
                                                    <span>💊</span>
                                                    <span>Administer Now</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-5 pt-4 border-top">
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-action="EditMedication" asp-route-id="@Model.MedicationId"
                           class="btn-professional-action btn-professional-edit">
                            <span>✏️</span>
                            <span>Edit Medication</span>
                        </a>
                        <a asp-action="DeleteMedication" asp-route-id="@Model.MedicationId"
                           class="btn-professional-action btn-professional-delete">
                            <span>🗑️</span>
                            <span>Delete</span>
                        </a>
                        <a asp-action="Medications" class="btn-professional-secondary">
                            <span>📋</span>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>