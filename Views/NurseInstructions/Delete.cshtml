@model HealthOps_Project.Models.NurseInstruction

@{
    ViewData["Title"] = "Delete Instruction";
}

<div class="container mt-5">
    <div class="card mx-auto shadow-lg" style="max-width: 600px;">
        <div class="card-header bg-danger text-white text-center">
            <h4>Confirm Delete</h4>
        </div>
        <div class="card-body text-center">
            <p>Are you sure you want to delete this instruction?</p>

            <dl class="row text-start">
                <dt class="col-sm-4">Patient</dt>
                <dd class="col-sm-8">@Model.Patient?.FirstName @Model.Patient?.LastName</dd>

                <dt class="col-sm-4">Instruction</dt>
                <dd class="col-sm-8">@Model.Instruction</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <a asp-controller="Dashboard" asp-action="Doctor" class="btn btn-outline-primary">← Back to Dashboard</a>
            </form>
        </div>
    </div>
</div>



