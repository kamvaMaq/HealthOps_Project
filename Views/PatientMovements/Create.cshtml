@model HealthOps_Project.Models.PatientMovement
@{
    ViewData["Title"] = "Create Patient Movement";
}

<style>
    .movements-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .header-gradient {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-control-custom {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 12px 20px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

        .form-control-custom:focus {
            border-color: #667eea;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.2);
            transform: translateY(-2px);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
            color: white;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }

    .current-location-card {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border: 2px solid #90caf9;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
    }
</style>

<div class="movements-container">
    <div class="container">
        <div class="glass-card">
            <div class="header-gradient">
                <h1 class="display-5 fw-bold mb-3">🚑 Create Patient Movement</h1>
                <p class="lead mb-0">Transfer patient to a new ward and update their location</p>
            </div>

            <div class="p-4">
                <!-- Current Location Display -->
                <div id="currentLocation" class="current-location-card" style="display: none;">
                    <h5 class="text-primary mb-3">📍 Current Patient Location</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <strong>Ward:</strong> <span id="currentWard">-</span>
                        </div>
                        <div class="col-md-4">
                            <strong>Room:</strong> <span id="currentRoom">-</span>
                        </div>
                        <div class="col-md-4">
                            <strong>Bed:</strong> <span id="currentBed">-</span>
                        </div>
                    </div>
                </div>

              <form asp-action="Create" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Patient -->
    <div class="col-md-6">
        <label class="form-label fw-bold">Patient</label>
        <select asp-for="PatientId" class="form-control form-control-custom" id="patientSelect">
            <option value="">-- Select Patient --</option>
            @foreach (var patient in ViewBag.Patients)
            {
                <option value="@patient.Value">@patient.Text</option>
            }
        </select>
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>

    <!-- Movement Type -->
    <div class="col-md-6">
        <label class="form-label fw-bold">Movement Type</label>
        <select asp-for="MovementType" class="form-control form-control-custom">
            <option value="">-- Select Type --</option>
            <option value="Admission">Admission</option>
            <option value="Transfer">Transfer</option>
            <option value="Discharge">Discharge</option>
            <option value="Internal Move">Internal Move</option>
        </select>
        <span asp-validation-for="MovementType" class="text-danger"></span>
    </div>

    <!-- Ward -->
    <div class="col-md-4">
        <label class="form-label fw-bold">Ward</label>
        <select asp-for="WardId" class="form-control form-control-custom">
            <option value="">-- Select Ward --</option>
            @foreach (var ward in ViewBag.Wards)
            {
                <option value="@ward.Value">@ward.Text</option>
            }
        </select>
        <span asp-validation-for="WardId" class="text-danger"></span>
    </div>

    <!-- Room -->
    <div class="col-md-4">
        <label class="form-label fw-bold">Room</label>
        <select asp-for="RoomId" class="form-control form-control-custom">
            <option value="">-- Select Room --</option>
            @foreach (var room in ViewBag.Rooms)
            {
                <option value="@room.Value">@room.Text</option>
            }
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <!-- Bed -->
    <div class="col-md-4">
        <label class="form-label fw-bold">Bed</label>
        <select asp-for="BedId" class="form-control form-control-custom">
            <option value="">-- Select Bed --</option>
            @foreach (var bed in ViewBag.Beds)
            {
                <option value="@bed.Value">@bed.Text</option>
            }
        </select>
        <span asp-validation-for="BedId" class="text-danger"></span>
    </div>

    <!-- Movement Date -->
    <div class="col-md-6">
        <label class="form-label fw-bold">Movement Date & Time</label>
        <input asp-for="MovementDate" class="form-control form-control-custom" type="datetime-local" />
        <span asp-validation-for="MovementDate" class="text-danger"></span>
    </div>

    <!-- ✅ Fixed Doctor Dropdown -->
  @*   <div class="col-md-6">
        <label asp-for="DoctorUserId" class="form-label fw-bold">Responsible Doctor</label>
        <select asp-for="DoctorUserId" asp-items="ViewBag.Doctors" class="form-control form-control-custom">
            <option value="">-- Select Doctor --</option>
        </select>
        <span asp-validation-for="DoctorUserId" class="text-danger"></span>
    </div> *@

    <!-- Notes -->
    <div class="col-12">
        <label class="form-label fw-bold">Notes</label>
        <textarea asp-for="ReasonForMovement" class="form-control form-control-custom" rows="3" placeholder="Additional notes about the movement..."></textarea>
        <span asp-validation-for="ReasonForMovement" class="text-danger"></span>
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn-primary-glow me-3">💾 Create Movement</button>
        <a asp-action="Index" class="btn-secondary-glow">↩️ Back to List</a>
    </div>
</form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function to fetch and display current patient location
        document.getElementById('patientSelect').addEventListener('change', function () {
            const patientId = this.value;
            const currentLocationDiv = document.getElementById('currentLocation');

            if (patientId) {
                // Show loading state
                currentLocationDiv.style.display = 'block';
                document.getElementById('currentWard').textContent = 'Loading...';
                document.getElementById('currentRoom').textContent = 'Loading...';
                document.getElementById('currentBed').textContent = 'Loading...';

                // In a real application, you'd make an AJAX call to get current location
                // For now, we'll simulate it or you can implement the actual API call
                fetch(`/PatientMovements/GetCurrentLocation?patientId=${patientId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.exists) {
                            document.getElementById('currentWard').textContent = data.ward || 'Not assigned';
                            document.getElementById('currentRoom').textContent = data.room || 'Not assigned';
                            document.getElementById('currentBed').textContent = data.bed || 'Not assigned';
                        } else {
                            document.getElementById('currentWard').textContent = 'No current assignment';
                            document.getElementById('currentRoom').textContent = '-';
                            document.getElementById('currentBed').textContent = '-';
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching current location:', error);
                        document.getElementById('currentWard').textContent = 'Error loading';
                        document.getElementById('currentRoom').textContent = '-';
                        document.getElementById('currentBed').textContent = '-';
                    });
            } else {
                currentLocationDiv.style.display = 'none';
            }
        });
    </script>
}