@model HealthOps_Project.Models.PatientMovement
@{
    ViewData["Title"] = "Patient Movement Details";
}

<style>
    /* Main Container Styles */
    .details-container {
        background: linear-gradient(135deg, #3498db 0%, #2c3e50 100%);
        min-height: 100vh;
        padding: 40px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .details-glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
        padding: 40px;
        width: 100%;
        max-width: 900px;
        position: relative;
        overflow: hidden;
    }

    .details-glass-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
        transform: rotate(45deg);
        animation: shine 8s infinite;
    }

    @@keyframes shine {
        0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
        100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    /* Header Styles */
    .details-header {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        padding: 30px;
        border-radius: 20px;
        text-align: center;
        margin-bottom: 40px;
        position: relative;
        overflow: hidden;
    }

    .details-header h2 {
        font-weight: 700;
        margin-bottom: 10px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }

    .details-header::after {
        content: '📋';
        position: absolute;
        top: 20px;
        right: 30px;
        font-size: 3rem;
        opacity: 0.3;
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(5deg); }
    }

    /* Movement ID Badge */
    .movement-id-badge {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 1.1rem;
        display: inline-block;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    /* Details Grid Styles */
    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }

    .detail-section {
        background: rgba(255, 255, 255, 0.7);
        border-radius: 15px;
        padding: 25px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .detail-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 5px;
        height: 100%;
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border-radius: 5px 0 0 5px;
    }

    .detail-section:hover {
        background: rgba(255, 255, 255, 0.9);
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .section-title {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 20px;
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 2px solid #3498db;
        padding-bottom: 10px;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .detail-item:hover {
        background: rgba(52, 152, 219, 0.05);
        border-radius: 8px;
        padding-left: 10px;
        padding-right: 10px;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        flex: 1;
    }

    .detail-value {
        flex: 2;
        text-align: right;
        color: #34495e;
        font-weight: 500;
    }

    .detail-value.highlight {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    /* Status Badges */
    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-admission {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
    }

    .badge-transfer {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
    }

    .badge-discharge {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .badge-theatre {
        background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
        color: white;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 15px 30px;
        border-radius: 15px;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.4s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
    }

    .btn-action::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s ease;
    }

    .btn-action:hover::before {
        left: 100%;
    }

    .btn-edit {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
    }

    .btn-back {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        color: white;
    }

    .btn-delete {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .btn-action:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        text-decoration: none;
        color: white;
    }

    /* Timeline Indicator */
    .timeline-indicator {
        position: relative;
        padding-left: 30px;
        margin: 20px 0;
    }

    .timeline-indicator::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 15px;
        height: 15px;
        background: #3498db;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 0 0 3px #3498db;
    }

    .timeline-indicator::after {
        content: '';
        position: absolute;
        left: 7px;
        top: 50%;
        width: 2px;
        height: 100%;
        background: #3498db;
        transform: translateY(50%);
    }

    /* Animations */
    .animate-details {
        animation: detailsSlideIn 0.8s ease-out;
    }

    @@keyframes detailsSlideIn {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .animate-stagger-1 { animation-delay: 0.1s; }
    .animate-stagger-2 { animation-delay: 0.2s; }
    .animate-stagger-3 { animation-delay: 0.3s; }
    .animate-stagger-4 { animation-delay: 0.4s; }

    /* Empty State */
    .empty-value {
        color: #95a5a6;
        font-style: italic;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .details-glass-card {
            padding: 25px;
            margin: 20px;
        }

        .details-header {
            padding: 20px;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .detail-section {
            padding: 20px;
        }

        .detail-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .detail-value {
            text-align: left;
            width: 100%;
        }

        .action-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-action {
            width: 100%;
            max-width: 250px;
            justify-content: center;
        }
    }

    /* Print Styles */
    @@media print {
        .details-container {
            background: white !important;
            padding: 0 !important;
        }

        .details-glass-card {
            box-shadow: none !important;
            border: 1px solid #ccc !important;
        }

        .action-buttons {
            display: none !important;
        }

        .btn-action {
            display: none !important;
        }
    }
</style>

<div class="details-container">
    <div class="details-glass-card animate-details">
        <!-- Header -->
        <div class="details-header">
            <div class="movement-id-badge">
                Patient: @Model.Patient?.FirstName @Model.Patient?.LastName
            </div>

            <h2>📋 Patient Movement Details</h2>
            <p class="mb-0">Complete information about patient movement record</p>
        </div>

        <!-- Details Grid -->
        <div class="details-grid">
            <!-- Patient Information Section -->
            <div class="detail-section animate-details animate-stagger-1">
                <h4 class="section-title">👤 Patient Information</h4>
                <div class="detail-item">
                    <span class="detail-label">Patient Name:</span>
                    <span class="detail-value highlight">
                        @(Model.Patient?.FirstName + " " + Model.Patient?.LastName ?? "N/A")
                    </span>
                </div>
               @*  <div class="detail-item">
                    <span class="detail-label">Patient ID:</span>
                    <span class="detail-value">@(Model.PatientId.ToString() ?? "N/A")</span>
                </div> *@
              <div class="detail-item">
    <span class="detail-label">Responsible Doctor:</span>
    <span class="detail-value">
        @(Model.DoctorUser != null 
            ? $"{Model.DoctorUser.FirstName} {Model.DoctorUser.LastName}" 
            : "Not assigned")
    </span>
</div>

            </div>

            <!-- Location Information Section -->
            <div class="detail-section animate-details animate-stagger-2">
                <h4 class="section-title">📍 Location Details</h4>
                <div class="detail-item">
                    <span class="detail-label">Ward:</span>
                    <span class="detail-value">@(Model.Ward?.Name ?? "N/A")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Room:</span>
                    <span class="detail-value">
                        @if (Model.Room?.RoomNumber != null)
                        {
                            <span class="status-badge badge-transfer">Room @Model.Room.RoomNumber</span>
                        }
                        else
                        {
                            <span class="empty-value">Not assigned</span>
                        }
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Bed:</span>
                    <span class="detail-value">
                        @if (Model.Bed?.BedNumber != null)
                        {
                            <span class="status-badge badge-admission">Bed @Model.Bed.BedNumber</span>
                        }
                        else
                        {
                            <span class="empty-value">Not assigned</span>
                        }
                    </span>
                </div>
            </div>

            <!-- Movement Details Section -->
            <div class="detail-section animate-details animate-stagger-3">
                <h4 class="section-title">🔄 Movement Details</h4>
                <div class="detail-item">
                    <span class="detail-label">Movement Type:</span>
                    <span class="detail-value">
                        @{
                            var badgeClass = "badge-transfer";
                            if (Model.MovementType?.ToLower().Contains("admit") == true) badgeClass = "badge-admission";
                            else if (Model.MovementType?.ToLower().Contains("discharge") == true) badgeClass = "badge-discharge";
                            else if (Model.MovementType?.ToLower().Contains("theatre") == true) badgeClass = "badge-theatre";
                        }
                        <span class="status-badge @badgeClass">@Model.MovementType</span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Movement Date:</span>
                    <span class="detail-value highlight">
                        @Model.MovementDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Movement Time:</span>
                    <span class="detail-value">
                        @Model.MovementDate.ToString("HH:mm")
                    </span>
                </div>
                <div class="detail-item timeline-indicator">
                    <span class="detail-label">Duration:</span>
                    <span class="detail-value">
                        @{
                            var duration = DateTime.Now - Model.MovementDate;
                            if (duration.TotalDays >= 1)
                            {
                                <text>@((int)duration.TotalDays) days ago</text>
                            }
                            else if (duration.TotalHours >= 1)
                            {
                                <text>@((int)duration.TotalHours) hours ago</text>
                            }
                            else
                            {
                                <text>@((int)duration.TotalMinutes) minutes ago</text>
                            }
                        }
                    </span>
                </div>
            </div>

            <!-- Additional Information Section -->
            <div class="detail-section animate-details animate-stagger-4">
                <h4 class="section-title">📝 Additional Information</h4>
                <div class="detail-item" style="align-items: flex-start;">
                    <span class="detail-label">Reason / Notes:</span>
                    <span class="detail-value" style="text-align: left;">
                        @if (!string.IsNullOrEmpty(Model.ReasonForMovement))
                        {
                            @Model.ReasonForMovement
                        }
                        else
                        {
                            <span class="empty-value">No additional notes provided</span>
                        }
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Record Created:</span>
                    <span class="detail-value">
                        @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value">
                        <span class="status-badge badge-admission">Active Record</span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.MovementId" class="btn-action btn-edit">
                ✏️ Edit Movement
            </a>
            <a asp-action="Index" class="btn-action btn-back">
                ⬅️ Back to List
            </a>
            <a asp-action="Delete" asp-route-id="@Model.MovementId" class="btn-action btn-delete">
                🗑️ Delete
            </a>
        </div>

        <!-- Quick Stats -->
        <div class="text-center mt-5">
            <small class="text-muted">
                📊 Movement recorded • 🔍 View only • 💾 Last updated: @DateTime.Now.ToString("HH:mm")
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add print functionality
            const printButton = document.createElement('button');
            printButton.innerHTML = '🖨️ Print';
            printButton.className = 'btn-action';
            printButton.style.background = 'linear-gradient(135deg, #34495e 0%, #2c3e50 100%)';
            printButton.addEventListener('click', function() {
                window.print();
            });

            // Add to action buttons
            const actionButtons = document.querySelector('.action-buttons');
            actionButtons.appendChild(printButton);

            // Add copy movement ID functionality
            const movementIdBadge = document.querySelector('.movement-id-badge');
            movementIdBadge.style.cursor = 'pointer';
            movementIdBadge.title = 'Click to copy Movement ID';

            movementIdBadge.addEventListener('click', function() {
                const movementId = '@Model.MovementId';
                navigator.clipboard.writeText(movementId).then(function() {
                    const originalText = movementIdBadge.textContent;
                    movementIdBadge.textContent = '✅ Copied!';
                    movementIdBadge.style.background = 'linear-gradient(135deg, #27ae60 0%, #2ecc71 100%)';
                    
                    setTimeout(function() {
                        movementIdBadge.textContent = originalText;
                        movementIdBadge.style.background = 'linear-gradient(135deg, #e74c3c 0%, #c0392b 100%)';
                    }, 2000);
                });
            });

            // Add auto-refresh for real-time updates
            setInterval(function() {
                const durationElements = document.querySelectorAll('.detail-item.timeline-indicator .detail-value');
                durationElements.forEach(function(element) {
                    // This would typically be updated from server data
                    // For demo, we'll just update the timestamp
                    element.textContent = 'Just now';
                });
            }, 60000); // Update every minute
        });
    </script>
}