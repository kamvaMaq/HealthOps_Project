@model HealthOps_Project.Models.Room
@{
    ViewData["Title"] = "Room Details";
}

<style>
    .details-room-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .header-gradient {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .detail-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        padding: 25px;
        margin: 20px 0;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1.1rem;
        color: #34495e;
        margin-bottom: 15px;
    }

    .btn-primary-glow {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(52, 152, 219, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }
</style>

<div class="details-room-container">
    <div class="container">
        <div class="glass-card">
            <div class="header-gradient">
                <h1 class="display-5 fw-bold mb-3">👁️ Room Details</h1>
                <p class="lead mb-0">View complete room information</p>
            </div>

            <div class="p-4">
                <div class="detail-card">
                    <h4 class="text-primary mb-4">Room Information</h4>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="detail-label">Room Number</div>
                            <div class="detail-value">@Model.RoomNumber</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="detail-label">Capacity</div>
                            <div class="detail-value">@Model.Capacity</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="detail-label">Status</div>
                            <div class="detail-value">
                                @if (Model.IsAvailable)

                                {
                                    <span class="badge bg-success fs-6">Available</span>
                                }

                                else

                                {
                                    <span class="badge bg-danger fs-6">Unavailable</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn-secondary-glow">
                        ↩️ Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn-primary-glow">
                        ✏️ Edit Room
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>