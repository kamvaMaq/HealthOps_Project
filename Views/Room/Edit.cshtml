@model HealthOps_Project.Models.Room
@{
    ViewData["Title"] = "Edit Room";
}

<style>
    .edit-room-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .header-gradient {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-control-custom {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 12px 20px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

        .form-control-custom:focus {
            border-color: #3498db;
            box-shadow: 0 10px 25px rgba(52, 152, 219, 0.2);
            transform: translateY(-2px);
        }

    .btn-primary-glow {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);
    }

        .btn-primary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(52, 152, 219, 0.4);
            color: white;
        }

    .btn-secondary-glow {
        background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        border: none;
        border-radius: 15px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(149, 165, 166, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary-glow:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 30px rgba(149, 165, 166, 0.4);
            color: white;
            text-decoration: none;
        }
</style>

<div class="edit-room-container">
    <div class="container">
        <div class="glass-card">
            <div class="header-gradient">
                <h1 class="display-5 fw-bold mb-3">✏️ Edit Room</h1>
                <p class="lead mb-0">Update room information and availability</p>
            </div>

            <div class="p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoomId" />

                    <div class="mb-3">
                        <label asp-for="RoomNumber" class="form-label fw-bold">Room Number</label>
                        <input asp-for="RoomNumber" class="form-control form-control-custom" />
                        <span asp-validation-for="RoomNumber" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capacity" class="form-label fw-bold">Capacity</label>
                        <input asp-for="Capacity" class="form-control form-control-custom" type="number" />
                        <span asp-validation-for="Capacity" class="text-danger small mt-1"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="IsAvailable" class="form-check-label fw-bold">Room Available</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn-secondary-glow">
                            ↩️ Back to List
                        </a>
                        <button type="submit" class="btn-primary-glow">
                            💾 Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}