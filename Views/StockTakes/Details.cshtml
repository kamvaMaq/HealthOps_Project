@model HealthOps_Project.Models.Stocktake

@{
    ViewData["Title"] = "Stocktake Details";
}

<link rel="stylesheet" href="~/css/professional-styles.css" />
<partial name="_BackButton" />

<div class="professional-management-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="professional-glass-card professional-animate-in">
                    <!-- Header -->
                    <div class="professional-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h1 class="display-6 fw-bold mb-2">
                                    <i class="fas fa-info-circle me-3"></i>Stocktake Details
                                </h1>
                                <p class="mb-0">Complete stocktake record information</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4">
                        <div class="professional-info-card mb-4">
                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Stocktake ID:</div>
                                <div class="col-sm-8">@Model.Id</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Consumable:</div>
                                <div class="col-sm-8">@Model.Consumable?.Name</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Ward Name:</div>
                                <div class="col-sm-8">
                                    <span class="professional-status-badge professional-badge-normal">
                                        @Model.WardName
                                    </span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Quantity Counted:</div>
                                <div class="col-sm-8">
                                    <span class="fw-bold fs-5 @(Model.QuantityCounted <= 10 ? "text-warning" : "text-success")">
                                        @Model.QuantityCounted
                                    </span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-4 fw-bold">Date Taken:</div>
                                <div class="col-sm-8">
                                    <div>@Model.DateTaken.ToString("MMMM dd, yyyy")</div>
                                    <div class="text-muted small">@Model.DateTaken.ToString("HH:mm tt")</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="row mb-3">
                                    <div class="col-sm-4 fw-bold">Notes:</div>
                                    <div class="col-sm-8">
                                        <div class="professional-info-card bg-light">
                                            @Model.Notes
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-professional-secondary me-md-2">
                                <i class="fas fa-arrow-left me-2"></i> Back to List
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-professional-primary">
                                <i class="fas fa-edit me-2"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/professional-scripts.js"></script>
}