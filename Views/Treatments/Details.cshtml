@model HealthOps_Project.Models.Treatment

@{
    ViewData["Title"] = "Treatment Details";
}

<div class="professional-management-container">
    <div class="container">
        <div class="professional-glass-card mb-5 professional-animate-in" style="max-width: 800px; margin: 0 auto;">
            <!-- Header -->
            <div class="professional-header">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="professional-icon-wrapper professional-float">
                        <span style="font-size: 2.2rem;">💊</span>
                    </div>
                </div>
                <h1 class="display-5 fw-bold mb-3">Treatment Details</h1>
                <p class="lead mb-0 fs-6 opacity-90">Complete treatment information and record</p>
            </div>

            <div class="p-4">
                <!-- Treatment Summary Card -->
                <div class="professional-stat-card mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold text-dark mb-2">
                                @{
                                    var p = Model.Patient;
                                    string patientName = p != null ? $"{p.FirstName ?? ""} {p.LastName ?? ""}".Trim() : "Unknown Patient";
                                }
                                @patientName
                            </h4>
                            <div class="d-flex flex-wrap gap-3">
                                <span class="professional-status-badge professional-badge-completed">
                                    ✅ @Model.TreatmentType
                                </span>
                                <span class="text-muted">
                                    📅 @Model.TreatmentDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="professional-entity-icon" style="margin: 0 auto;">
                                🏥
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="row g-4">
                    <!-- Treatment Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">📋</span>
                                Treatment Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Treatment Type</small>
                                    <div class="fw-bold text-dark">@Model.TreatmentType</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Performed By</small>
                                    <div class="fw-bold text-dark">@Model.PerformedBy</div>
                                </div>
                                <div>
                                    <small class="text-muted fw-semibold">Date & Time</small>
                                    <div class="fw-bold text-dark">@Model.TreatmentDate.ToString("MMM dd, yyyy 'at' h:mm tt")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Information -->
                    <div class="col-md-6">
                        <div class="professional-info-card h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">👤</span>
                                Patient Information
                            </h6>
                            <div class="space-y-3">
                                <div>
                                    <small class="text-muted fw-semibold">Patient Name</small>
                                    <div class="fw-bold text-dark">@patientName</div>
                                </div>
                                @if (p != null)
                                {
                                    <div>
                                        <small class="text-muted fw-semibold">Patient ID</small>
                                        <div class="fw-bold text-dark">@p.PatientId</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Treatment Details -->
                    <div class="col-12">
                        <div class="professional-info-card">
                            <h6 class="fw-bold text-dark mb-3">
                                <span class="me-2">📝</span>
                                Treatment Details
                            </h6>
                            <div class="bg-light rounded-3 p-3">
                                <p class="mb-0 text-dark">@Model.Details</p>
                            </div>
                        </div>
                    </div>

                    <!-- Clinical Notes -->
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="professional-info-card">
                                <h6 class="fw-bold text-dark mb-3">
                                    <span class="me-2">📋</span>
                                    Clinical Notes
                                </h6>
                                <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                                    <p class="mb-0 text-dark">@Model.Notes</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-5 pt-4 border-top">
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.TreatmentId"
                           class="btn-professional-action btn-professional-edit">
                            <span>✏️</span>
                            <span>Edit Treatment</span>
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.TreatmentId"
                           class="btn-professional-action btn-professional-delete">
                            <span>🗑️</span>
                            <span>Delete</span>
                        </a>
                        <a asp-action="Index" class="btn-professional-secondary">
                            <span>📋</span>
                            <span>Back to List</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

