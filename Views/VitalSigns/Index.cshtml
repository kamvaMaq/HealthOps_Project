                    </div>
                </div>
            </div>

            <!-- Professional Statistics Cards -->
            <div class="row g-4 px-4 pb-4 professional-stagger">
                <div class="col-md-3">
                    <div class="professional-stat-card">
                        <div class="stat-number text-primary fw-bold" style="font-size: 2.4rem;">@Model.Count()</div>
                        <div class="text-muted fw-semibold mb-2">Total Records</div>
                        <div class="utilization-chart">
                            <div class="utilization-fill" style="width: 100%"></div>
                        </div>
                        <small class="text-success">📈 Complete History</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="professional-stat-card">
                        @{
                            var normalVitals = Model.Count(v => GetVitalStatus(v) == "normal");
                            var normalPercent = Model.Any() ? (normalVitals * 100 / Model.Count()) : 0;
                        }
                        <div class="stat-number text-success fw-bold" style="font-size: 2.4rem;">@normalVitals</div>
                        <div class="text-muted fw-semibold mb-2">Normal Readings</div>
                        <div class="utilization-chart">
                            <div class="utilization-fill" style="width: @normalPercent%; background: linear-gradient(90deg, #27ae60, #2ecc71);"></div>
                        </div>
                        <small class="text-success">✅ Stable Condition</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="professional-stat-card">
                        @{
                            var warningVitals = Model.Count(v => GetVitalStatus(v) == "warning");
                            var warningPercent = Model.Any() ? (warningVitals * 100 / Model.Count()) : 0;
                        }
                        <div class="stat-number text-warning fw-bold" style="font-size: 2.4rem;">@warningVitals</div>
                        <div class="text-muted fw-semibold mb-2">Warning Signs</div>
                        <div class="utilization-chart">
                            <div class="utilization-fill" style="width: @warningPercent%; background: linear-gradient(90deg, #f39c12, #e67e22);"></div>
                        </div>
                        <small class="text-warning">⚠️ Monitor Closely</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="professional-stat-card">
                        @{
                            var criticalVitals = Model.Count(v => GetVitalStatus(v) == "critical");
                            var criticalPercent = Model.Any() ? (criticalVitals * 100 / Model.Count()) : 0;
                        }
                        <div class="stat-number text-danger fw-bold" style="font-size: 2.4rem;">@criticalVitals</div>
                        <div class="text-muted fw-semibold mb-2">Critical Alerts</div>
                        <div class="utilization-chart">
                            <div class="utilization-fill" style="width: @criticalPercent%; background: linear-gradient(90deg, #e74c3c, #c0392b);"></div>
                        </div>
                        <small class="text-danger">🚨 Immediate Attention</small>
                    </div>
                </div>
            </div>

            <!-- Additional Information Cards -->
            <div class="row px-4 pb-4">
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">📊 Vital Status Distribution</h6>
                            <span class="badge bg-primary">Analysis</span>
                        </div>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Normal: @normalVitals records</small>
                                <small>@normalPercent%</small>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <small>Warning: @warningVitals records</small>
                                <small>@warningPercent%</small>
                            </div>
                            <div class="d-flex justify-content-between">
                                <small>Critical: @criticalVitals records</small>
                                <small>@criticalPercent%</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">⏱️ Monitoring Frequency</h6>
                            <span class="badge bg-success">Optimal</span>
                        </div>
                        <p class="mb-0 mt-2 text-muted">Average records per day: <strong>@(Model.Any() ? (Model.Count() / Math.Max(1, (DateTime.Now - Model.Min(v => v.RecordedDate)).Days)) : 0)</strong></p>
                        <small class="text-muted">Based on current monitoring schedule</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vitals Table Professional Card -->
        <div class="professional-glass-card professional-animate-in" style="animation-delay: 0.2s;">
            <div class="table-responsive">
                <table class="table professional-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 20%">Date Recorded</th>
                            <th style="width: 15%">Temperature</th>
                            <th style="width: 15%">Blood Pressure</th>
                            <th style="width: 10%">Heart Rate</th>
                            <th style="width: 10%">O₂ Saturation</th>
                            <th style="width: 10%">Weight</th>
                            <th style="width: 10%">Status</th>
                            <th style="width: 10%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="professionalVitalsTableBody">
                        @if (Model.Any())
                        {
                            var animationDelay = 0.3;
                            @foreach (var vital in Model)
                            {
                                var vitalStatus = GetVitalStatus(vital);
                                var statusClass = vitalStatus == "normal" ? "professional-badge-normal" :
                                vitalStatus == "warning" ? "professional-badge-warning" :
                                "professional-badge-critical";

                                <tr class="professional-table-row" style="animation-delay: @(animationDelay)s;">
                                    <!-- Date Recorded -->
                                    <td style="width:20%;">
                                        <div class="d-flex align-items-center">
                                            <div class="professional-vital-icon professional-pulse me-3">
                                                📅
                                            </div>
                                            <div>
                                                <div class="fw-bold fs-6 text-dark">@vital.RecordedDate.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">@vital.RecordedDate.ToString("HH:mm")</small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Temperature -->
                                    <td style="width:15%;">
                                        <div class="vital-value @GetValueClass("temperature", vital.Temperature)">
                                            @vital.Temperature°C
                                        </div>
                                        <small class="text-muted">Body Temp</small>
                                    </td>

                                    <!-- Blood Pressure -->
                                    <td style="width:15%;">
                                        <div class="vital-value @GetValueClass("bp", vital.BloodPressure)">
                                            @vital.BloodPressure
                                        </div>
                                        <small class="text-muted">mmHg</small>
                                    </td>

                                    <!-- Heart Rate -->
                                    <td style="width:10%;">
                                        <div class="vital-value @GetValueClass("hr", vital.HeartRate)">
                                            @vital.HeartRate
                                        </div>
                                        <small class="text-muted">BPM</small>
                                    </td>

                                    <!-- Oxygen Saturation -->
                                    <td style="width:10%;">
                                        <div class="vital-value @GetValueClass("o2", vital.OxygenSaturation)">
                                            @vital.OxygenSaturation%
                                        </div>
                                        <small class="text-muted">SpO₂</small>
                                    </td>

                                    <!-- Weight -->
                                    <td style="width:10%;">
                                        <div class="vital-value vital-value-normal">
                                            @vital.Weight kg
                                        </div>
                                        <small class="text-muted">Body Weight</small>
                                    </td>

                                    <!-- Status -->
                                    <td style="width:10%;">
                                        <span class="professional-status-badge @statusClass">
                                            @GetStatusIcon(vitalStatus) @vitalStatus.ToUpper()
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td style="width:10%;" class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="@Url.Action("Details", new { id = vital.VitalId })"
                                               class="btn-professional-action btn-professional-details">
                                                <span>👁️</span>
                                                <span>View</span>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = vital.VitalId })"
                                               class="btn-professional-action btn-professional-edit">
                                                <span>✏️</span>
                                                <span>Edit</span>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = vital.VitalId })"
                                               class="btn-professional-action btn-professional-delete">
                                                <span>🗑️</span>
                                                <span>Remove</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                animationDelay += 0.1;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="professional-empty-state text-center py-5">
                                        <div class="professional-empty-state-icon">❤️</div>
                                        <h3 class="fw-bold text-dark mb-3">No Vital Signs Recorded</h3>
                                        <p class="text-muted fs-6 mb-4">Start monitoring patient health by recording the first set of vital signs</p>
                                        @if (ViewBag.Patient != null)
                                        {
                                            <a href="@Url.Action("Create", new { patientId = ViewBag.Patient.PatientId })" class="btn-professional-primary">
                                                <span>🚀</span>
                                                <span>Record First Vitals</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("SelectPatient")" class="btn-professional-primary">
                                                <span>👤</span>
                                                <span>Select Patient First</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Professional search functionality with enhanced debouncing
        let professionalSearchTimeout;
        $(document).ready(function () {
            $('#professionalSearchInput').on('keyup', function () {
                clearTimeout(professionalSearchTimeout);
                professionalSearchTimeout = setTimeout(() => {
                    var query = $(this).val().toLowerCase();
                    var visibleRows = 0;

                    $('.professional-table-row').each(function () {
                        var rowText = $(this).text().toLowerCase();
                        if (rowText.indexOf(query) > -1) {
                            $(this).slideDown(400);
                            visibleRows++;
                        } else {
                            $(this).slideUp(400);
                        }
                    });

                    // Update statistics in real-time
                    updateSearchStatistics(visibleRows);
                }, 350);
            });
        });

        // Enhanced professional interactions
        document.addEventListener('DOMContentLoaded', function () {
            // Professional filter functionality
            document.querySelectorAll('.professional-filter-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    // Remove active class from all buttons
                    document.querySelectorAll('.professional-filter-btn').forEach(b => b.classList.remove('active'));
                    // Add active class to clicked button
                    this.classList.add('active');

                    const filter = this.dataset.filter;
                    let visibleCount = 0;

                    $('.professional-table-row').each(function () {
                        const $row = $(this);
                        const status = $row.find('.professional-status-badge').text().toLowerCase();
                        const date = $row.find('td:first-child').text().toLowerCase();
                        const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toLowerCase();

                        switch (filter) {
                            case 'all':
                                $row.fadeIn(500);
                                visibleCount++;
                                break;
                            case 'normal':
                                $row.toggle(status.includes('normal'));
                                if (status.includes('normal')) visibleCount++;
                                break;
                            case 'warning':
                                $row.toggle(status.includes('warning'));
                                if (status.includes('warning')) visibleCount++;
                                break;
                            case 'critical':
                                $row.toggle(status.includes('critical'));
                                if (status.includes('critical')) visibleCount++;
                                break;
                            case 'today':
                                $row.toggle(date.includes(today));
                                if (date.includes(today)) visibleCount++;
                                break;
                        }
                    });

                    // Update filter statistics
                    updateFilterStatistics(filter, visibleCount);
                });
            });

            // Enhanced hover effects for professional stat cards
            document.querySelectorAll('.professional-stat-card').forEach(card => {
                card.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-6px) scale(1.02)';
                });

                card.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });

            // Professional ripple effect for action buttons
            document.querySelectorAll('.btn-professional-action').forEach(button => {
                button.addEventListener('click', function (e) {
                    // Create professional ripple element
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;

                    ripple.style.cssText = `
                                        position: absolute;
                                        border-radius: 50%;
                                        background: rgba(255, 255, 255, 0.6);
                                        transform: scale(0);
                                        animation: professionalRipple 0.6s linear;
                                        width: ${size}px;
                                        height: ${size}px;
                                        left: ${x}px;
                                        top: ${y}px;
                                    `;

                    this.appendChild(ripple);

                    // Remove ripple after animation
                    setTimeout(() => {
                        ripple.remove();
                    }, 600);
                });
            });

            // Enhanced professional search box interactions
            const professionalSearchBox = document.getElementById('professionalSearchInput');
            if (professionalSearchBox) {
                professionalSearchBox.addEventListener('focus', function () {
                    this.style.transform = 'translateY(-2px)';
                    this.style.boxShadow = '0 12px 30px rgba(106, 17, 203, 0.25)';
                });

                professionalSearchBox.addEventListener('blur', function () {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 6px 20px rgba(0, 0, 0, 0.08)';
                });
            }

            // Professional status badge interactions
            document.querySelectorAll('.professional-status-badge').forEach(badge => {
                badge.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-2px) scale(1.05)';
                    this.style.boxShadow = '0 8px 20px rgba(0, 0, 0, 0.25)';
                });

                badge.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0) scale(1)';
                    if (this.classList.contains('professional-badge-normal')) {
                        this.style.boxShadow = '0 4px 15px rgba(39, 174, 96, 0.3)';
                    } else if (this.classList.contains('professional-badge-warning')) {
                        this.style.boxShadow = '0 4px 15px rgba(243, 156, 18, 0.3)';
                    } else {
                        this.style.boxShadow = '0 4px 15px rgba(231, 76, 60, 0.3)';
                    }
                });
            });

            // Professional table row interactions
            document.querySelectorAll('.professional-table-row').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (!e.target.closest('a')) {
                        this.style.background = 'linear-gradient(135deg, #f0f4ff 0%, #e6f0ff 100%)';
                        setTimeout(() => {
                            this.style.background = '';
                        }, 500);
                    }
                });
            });

            // Add professional CSS for ripple animation
            const professionalStyle = document.createElement('style');
            professionalStyle.textContent = `
                                @@keyframes professionalRipple {
                                    to {
                                        transform: scale(4);
                                        opacity: 0;
                                    }
                                }
                            `;
            document.head.appendChild(professionalStyle);

            // Professional auto-refresh simulation
            setInterval(() => {
                console.log('🔄 Professional auto-refresh: Checking for vital sign updates...');
                // In a real application, this would fetch new data from the server
                updateLiveIndicators();
            }, 45000);

            // Initialize professional functions
            function updateSearchStatistics(visibleCount) {
                console.log(`🔍 Professional search: ${visibleCount} vital records match your criteria`);
            }

            function updateFilterStatistics(filter, count) {
                console.log(`🎯 Professional filter "${filter}": Showing ${count} vital records`);
            }

            function updateLiveIndicators() {
                // Update live indicators with subtle animations
                document.querySelectorAll('.professional-pulse').forEach(element => {
                    element.style.animation = 'none';
                    setTimeout(() => {
                        element.style.animation = 'professionalPulse 2.5s infinite';
                    }, 10);
                });
            }
        });
    </script>
}
@functions {
    private string GetVitalStatus(HealthOps_Project.Models.VitalSign vital)
    {
        // Simple logic to determine vital status - you can customize this based on medical standards

        // Check heart rate with null handling
        if (vital.HeartRate.HasValue && (vital.HeartRate < 60 || vital.HeartRate > 100)) return "warning";

        // Check temperature with null handling
        if (vital.Temperature.HasValue)
        {
            decimal temp = vital.Temperature.Value;
            if (temp < 36.1m || temp > 37.5m) return "warning";
        }

        // Check oxygen saturation with null handling
        if (vital.OxygenSaturation.HasValue && vital.OxygenSaturation < 95) return "critical";

        // Check blood pressure (simplified)
        if (!string.IsNullOrEmpty(vital.BloodPressure))
        {
            var bpParts = vital.BloodPressure.Split('/');
            if (bpParts.Length == 2)
            {
                if (int.TryParse(bpParts[0], out int systolic) && int.TryParse(bpParts[1], out int diastolic))
                {
                    if (systolic > 140 || diastolic > 90) return "warning";
                    if (systolic < 90 || diastolic < 60) return "critical";
                }
            }
        }

        return "normal";
    }

    private string GetValueClass(string type, object value)
    {
        if (value == null) return "vital-value-normal";

        string stringValue = value.ToString();

        switch (type)
        {
            case "temperature":
                if (decimal.TryParse(stringValue, out decimal temp))
                {
                    if (temp < 36.1m || temp > 37.5m) return "vital-value-warning";
                    if (temp < 35m || temp > 39m) return "vital-value-critical";
                }
                break;

            case "hr":
                if (int.TryParse(stringValue, out int hr))
                {
                    if (hr < 60 || hr > 100) return "vital-value-warning";
                    if (hr < 40 || hr > 140) return "vital-value-critical";
                }
                break;

            case "o2":
                if (int.TryParse(stringValue, out int o2))
                {
                    if (o2 < 95) return "vital-value-warning";
                    if (o2 < 90) return "vital-value-critical";
                }
                break;

            case "bp":
                // Simplified BP check
                var bpParts = stringValue.Split('/');
                if (bpParts.Length == 2)
                {
                    if (int.TryParse(bpParts[0], out int systolic) && int.TryParse(bpParts[1], out int diastolic))
                    {
                        if (systolic > 140 || diastolic > 90) return "vital-value-warning";
                        if (systolic < 90 || diastolic < 60) return "vital-value-critical";
                    }
                }
                break;
        }

        return "vital-value-normal";
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "normal" => "✅",
            "warning" => "⚠️",
            "critical" => "🚨",
            _ => "📊"
        };
    }
}
